  },
  "lookFields": {
    "set": "car = one of the ModCar names (tools/blender/lib/modcar.py MAT_NAMES); v3 = added for the V3 families",
    "base": "default lit colour; a model's own material colour replaces it",
    "shade": "[sat, val, r, g, b]: the shade tone from the lit one: sat (0..1) more saturated, val times as bright, times the tint r g b (default 1 1 1)",
    "term": "[at, soft, second]: the terminator: n.l at its middle, half its width, strength of the second step where a face is square to the sun",
    "rim": "[sky, sun, power]: the rim the sky lights, the rim the sun lights from behind, how fast it falls off",
    "back": "light through it when the sun is behind (thin things: leaves, fins, ears)",
    "spec": "[strength, cos, catch]: the hard highlight: strength, cosine of its radius on the normal, catch 0 = where the sun is mirrored .. 1 = always turned to the eye (eyes)",
    "sheen": "a hard band of sky mirrored in what faces up (metal, liquid, wet scales)",
    "snow": "how much of the world's snow settles on it where it faces up (only when the look is in the weather)",
    "wet": "how much the world's rain darkens it (only when the look is in the weather)",
    "glow": "self-lit, times the lit colour",
    "lamp": "self-lit only when the look's lamp is on, times the lit colour",
    "opacity": "below 1: see-through",
    "card": "true: leaf cards, cut out of the shared leaf texture by their UVs, both sides drawn, their shadow cut out too, not inked",
    "ink": "seed 0..1 that keeps the ink ids of neighbouring materials apart"
  },
