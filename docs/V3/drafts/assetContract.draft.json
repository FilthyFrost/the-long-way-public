  "schema": 1,
  "about": "The V3 asset contract (docs/V3/ASSETS.md): what a model under public/models/v3 may contain. One source for the Blender tools (tools/blender/v3/common.py), the game's toon look (toonMaterials.ts) and the gate (harness/sim/v3_assets.test.ts). Colours are linear RGB.",
  "conventions": {
    "blenderAxes": "X forward, Y left, Z up; metres",
    "gameAxes": "+x forward, +y up, +z right; game(x, y, z) = blender(x, z, -y)",
    "lodNode": "LOD<n>",
    "maxLods": 4,
    "rigNode": "RIG",
    "mountPrefix": "M_",
    "colourAttribute": "Col",
    "fps": 30,
    "maxInfluences": 4
  },
  "budgets": {
    "animal_large": { "triangles": 6000, "bones": 40, "kilobytes": 600 },
    "animal_small": { "triangles": 2500, "bones": 28, "kilobytes": 300 },
