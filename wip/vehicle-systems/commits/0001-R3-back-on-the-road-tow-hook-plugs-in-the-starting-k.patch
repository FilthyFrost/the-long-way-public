+  private stuckT = 0;
+  private readonly b = new Float64Array(9);
+
+  /** @param waterDepth how deep the water stands at the vehicle (m, 0 = dry) */
+  update(dt: number, sim: VehicleSim, throttle: number, waterDepth: number): Plight {
+    sim.basis(this.b);
+    const up = this.b[4];
