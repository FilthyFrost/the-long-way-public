diff --git a/harness/sim/recover.test.ts b/harness/sim/recover.test.ts
new file mode 100644
index 0000000..334ffe5
--- /dev/null
+++ b/harness/sim/recover.test.ts
@@ -0,0 +1,108 @@
+/** Back on the road (recover.ts): rolled, in a lake, in a ditch, beside a wreck; on a real world. */
+import { describe, expect, it } from 'vitest';
+import { StaticSolids } from '../../src/core/onfoot/statics';
+import { VehicleSim, zeroInput } from '../../src/core/vehicle/sim';
+import { T0_TRUCK, T3_RV } from '../../src/core/vehicle/spec';
+import { findRecoverySpot, placeAtSpot, PlightWatch, RECOVER_REACH, type RecoverPoint, type RecoverWorld } from '../../src/core/vehicle/systems';
+import { FlatGround } from '../../src/core/world/ground';
+import { World } from '../../src/core/world/terrain';
+import { SpineSample } from '../../src/core/world/spine';
+
+/** a straight road along +x; a bridge over 100…140 m; a place's ground over 200…260 m; a lake right of 300…340 */
+function straight(): RecoverWorld {
+  return {
+    spine: {
+      project: (x, z, _h, out) => {
+        out.s = x;
+        out.d = z;
+      },
+      at: (s, out) => {
+        out.x = s;
+        out.y = 0;
+        out.z = 0;
+        out.phi = 0;
+      },
+    },
+    shape: (x, z, o: RecoverPoint) => {
+      o.h = Math.abs(z) > 6 ? -1.5 : 0; // a ditch beside the road
+      o.bridge = x > 100 && x < 140 ? 1 : 0;
+      o.site = x > 200 && x < 260 && z > 0 ? 1 : 0;
+      o.wl = x > 300 && x < 340 ? 0.5 : -Infinity;
+    },
+  };
+}
+
+describe('back on the road', () => {
+  it('a truck in the ditch goes back to the lane beside it, along the road', () => {
+    const r = findRecoverySpot(straight(), T0_TRUCK, 50, 14, null);
+    expect(r.ok).toBe(true);
+    expect(r.x).toBeCloseTo(50, 0);
+    expect(r.z).toBeCloseTo(1.6, 6);
+    expect(r.yaw).toBeCloseTo(0, 9);
+  });
+
+  it('nothing within reach: refused', () => {
+    expect(findRecoverySpot(straight(), T0_TRUCK, 50, RECOVER_REACH + 20, null).reason).toBe('far');
+  });
+
+  it('not on a bridge deck, not on a place, never in the lake, when it can be helped', () => {
+    const w = straight();
+    const b = findRecoverySpot(w, T0_TRUCK, 120, 3, null);
+    expect(b.ok && !b.onBridge).toBe(true);
+    expect(Math.abs(b.x - 120)).toBeLessThanOrEqual(24);
+    const p = findRecoverySpot(w, T0_TRUCK, 230, 8, null);
+    expect(p.ok && !p.onSite).toBe(true);
+    const l = findRecoverySpot(w, T0_TRUCK, 320, 10, null);
+    expect(l.ok).toBe(true);
+    expect(l.x <= 300 || l.x >= 340).toBe(true);
+  });
+
+  it('a wreck standing in the lane: the spot moves along the road until the body is clear', () => {
+    const solids = new StaticSolids();
+    solids.box(50, 1.6, 2.2, 1.0, 0, -0.5, 1.5, false, 'site3:wreck');
+    const r = findRecoverySpot(straight(), T3_RV, 50, 6, solids);
+    expect(r.ok).toBe(true);
+    expect(Math.abs(r.x - 50)).toBeGreaterThan(5);
+    // the body there touches nothing
+    const near: unknown[] = [];
+    solids.solidsNear(r.x, r.z, 0.1, near as never);
+    expect(Math.abs(r.x - 50) - 2.2 - T3_RV.body.halfLength).toBeGreaterThan(-0.3);
+  });
+
+  it('rolled over: watched, said, and put back upright, stopped, handbrake on, four wheels down', () => {
+    const g = new FlatGround();
+    const v = new VehicleSim(T0_TRUCK);
+    v.reset(30, 0, 10, 0);
+    // on its roof
+    v.qx = 1;
+    v.qw = 0;
+    const watch = new PlightWatch();
+    expect(watch.update(0.1, v, 0, 0)).toBe('rolled');
+    const spot = findRecoverySpot(straight(), T0_TRUCK, v.px, v.pz, null);
+    placeAtSpot(v, spot);
+    for (let i = 0; i < 240; i++) v.substep(zeroInput(), g);
+    expect(v.wheels.every((w) => w.contact)).toBe(true);
+    expect(v.parkBrake).toBe(1);
+    expect(v.speed).toBeLessThan(0.05);
+    expect(watch.update(0.1, v, 0, 0)).toBe('ok');
+    // stuck: pressing on for 10 s without moving
+    for (let t = 0; t < 10.05; t += 0.1) watch.update(0.1, v, 1, 0);
+    expect(watch.plight).toBe('stuck');
+    expect(watch.update(0.1, v, 0, 1)).toBe('water');
+  });
+
+  it('on a real world: from 40 m off the road onto it, settled on four wheels', () => {
+    const w = new World(20261113);
+    const sp = new SpineSample();
+    w.spine.at(3000, sp);
+    const x = sp.x - Math.sin(sp.phi) * 40;
+    const z = sp.z + Math.cos(sp.phi) * 40;
+    const r = findRecoverySpot(w, T0_TRUCK, x, z, w.sites);
+    expect(r.ok).toBe(true);
+    const v = new VehicleSim(T0_TRUCK);
+    placeAtSpot(v, r);
+    for (let i = 0; i < 360; i++) v.substep(zeroInput(), w);
+    expect(v.wheels.every((wh) => wh.contact)).toBe(true);
+    expect(v.speed).toBeLessThan(0.1);
+  });
+});
