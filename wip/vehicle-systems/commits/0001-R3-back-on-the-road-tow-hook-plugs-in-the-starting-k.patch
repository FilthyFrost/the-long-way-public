From d46a55e58e76ec82d832df1b8dc4dfa5304979ad Mon Sep 17 00:00:00 2001
From: road-trip-loop <loop@road-trip-game.local>
Date: Sat, 14 Nov 2026 12:24:23 -0800
Subject: [PATCH] R3: back on the road (tow hook), plugs in the starting kit,
 the journey run's hooks
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- core/vehicle/systems/recover.ts: findRecoverySpot puts the vehicle on
  the nearest road point within 300 m (right lane, along the road),
  stepping along the road until the body is clear of every solid, off
  bridge decks and places' ground when it can be, never into water;
  placeAtSpot (upright, stopped, handbrake on). PlightWatch: rolled over,
  stuck for 10 s, in water -> systems.plight -> the dash's radio line.
  The tow hook (carPlaces.ts) offers "回到路上" when needed: hold 3 s.
  Tests: recover.test.ts (ditch, far, bridge / place / lake, a wreck in
  the lane, rolled, a real world).
- Every vehicle's kit carries two tyre plugs; econ_punctures_no_remedy
  <= 1 (runs show 0). The traveller counts only the vehicle's own parts.
- Safety net: solids tagged with the vehicle's id or `<id>:...` are
  never in its way (test: a glovebox and a crate inside the truck move,
  thump and pinch nothing).
- Sim: a scripted input that is NaN counts as nothing pressed.
- Channel uses (car places, tow hook, filler) restart when E is let go,
  counted from the picker's asks (they did not, under scripted holds).
- Journey smoke run (harness/shots/journey.mjs, npm run journey) and its
  hooks (src/game/systems/journeyHooks.ts, __rt.journey); systems shots
  rolled_in_verge, back_on_road.
- Economy re-recorded on the new world and loot: engine minimum 35 -> 30
  (first kit comes later; see CHANGELOG).

Gate: npm run check && npm run measure && npm test && npm run judge
  Tests  787 passed | 4 skipped (791)
  676/693 metrics in range, 17 not measured yet (render/biomes, onfoot, roads, sites: browser)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/harness/shots/journey.mjs b/harness/shots/journey.mjs
new file mode 100644
index 0000000..7393723
--- /dev/null
+++ b/harness/shots/journey.mjs
@@ -0,0 +1,223 @@
+// Journey smoke run: one roadside stop played end to end in the real page (vehicle systems, the
+// player base and the world meeting for real). One browser session; every step asserts what it
+// should have changed and saves loop/shots/journey/NN_<step>.png; the first step that does not
+// reach its state fails the run (exit 1) with what it saw.
+//   node harness/shots/journey.mjs [--seed N]
+// Run it under the shared browser lock (flock), like every browser run.
+import fs from 'node:fs';
+import path from 'node:path';
+import { ROOT, launchBrowser, openGame, startServer } from './lib.mjs';
+
+const args = process.argv.slice(2);
+const seedArg = args.indexOf('--seed');
+const seed = seedArg >= 0 ? Number(args[seedArg + 1]) : 20261113;
+const outDir = path.join(ROOT, 'loop/shots/journey');
+fs.rmSync(outDir, { recursive: true, force: true });
+fs.mkdirSync(outDir, { recursive: true });
+
+const t0 = Date.now();
+const log = [];
+const say = (s) => {
+  const line = `[${((Date.now() - t0) / 1000).toFixed(1).padStart(5)} s] ${s}`;
+  log.push(line);
+  console.log(line);
+};
+
+const { server, url } = await startServer();
+const browser = await launchBrowser();
+let page;
+let errors = [];
+let n = 0;
+let failed = false;
+
+async function shot(name) {
+  n++;
+  const file = path.join(outDir, `${String(n).padStart(2, '0')}_${name}.png`);
+  await page.evaluate(() => window.__rt.render());
+  await page.screenshot({ path: file, timeout: 120_000 });
+  return file;
+}
+
+/** one step: run it, check it, take its picture; the first failure stops the journey */
+async function step(name, fn, check) {
+  if (failed) return null;
+  const got = await fn();
+  const ok = check ? await check(got) : true;
+  const file = await shot(name);
+  const errs = errors.splice(0);
+  if (ok !== true || errs.length) {
+    failed = true;
+    say(`FAIL ${name}: ${ok === true ? '' : ok} ${errs.length ? 'console: ' + errs.join(' | ') : ''}\n      saw: ${JSON.stringify(got)}\n      picture: ${path.relative(ROOT, file)}`);
+  } else say(`ok   ${name}  ${JSON.stringify(got)}`);
+  return got;
+}
+
+const ev = (fn, ...a) => page.evaluate(fn, a);
+const tele = () => ev(() => window.__rt.telemetry());
+const sys = () => ev(() => window.__rt.sys.state());
+
+try {
+  // ---- find a station early on this seed, start 300 m before it
+  // one page: find the station, go to 300 m before it, set the state (low fuel, a tired engine, a flat)
+  ({ page, errors } = await openGame(browser, `${url}/?seed=${seed}&shot=1&vehicle=truck&s=60&time=10`, { width: 1280, height: 720 }));
+  const st = await ev(() => window.__rt.journey.findStation(0, 40000));
+  if (!st) throw new Error(`seed ${seed}: no station in the first 40 km`);
+  say(`station ${st.id} at s = ${st.s.toFixed(0)} (side ${st.side}), tank ${st.tank.litres} L, containers ${st.containers.map((c) => c.kind).join(',')}`);
+  await ev(([s]) => window.__rt.goto(s), Math.round(st.s - 300));
+  await ev(() => window.__rt.sys.set('fuel:0.12,engine:35,flat:1'));
+
+  const start = await step('start', async () => {
+    const s = await sys();
+    return { fuelL: s.fuelL, engine: s.slots.engine.cond, flat1: s.wheels[1].flat, running: s.running };
+  }, (g) => (g.fuelL < 3 && Math.abs(g.engine - 35) < 0.5 && g.flat1 && g.running ? true : 'not the starting state asked for'));
+
+  // ---- drive in: along the road to abreast of the tank, then onto the pad beside it (filler side to the tank)
+  const parked = await step('drive_in', async () => {
+    const T = st.tank;
+    // the road heading here, from the car's own yaw at the start
+    const car = await ev(() => window.__rt.journey.bodyPoint(0, 0, 0));
+    const fx = Math.cos(car.yaw);
+    const fz = Math.sin(car.yaw);
+    const rx = -fz;
+    const rz = fx;
+    // the filler is on the driver's (left) side of the truck, behind the cab: put the car's left 1.4 m off the tank, filler abreast
+    const fillerLocal = await ev(() => {
+      const sp = window.__rt.game.sim.spec;
+      return { x: sp.body.centerX - sp.body.halfLength * 0.62, z: (sp.eye.z > 0 ? 1 : -1) * sp.body.halfWidth };
+    });
+    const side = fillerLocal.z < 0 ? 1 : -1; // the tank lies on the filler's side: stand the car on the far side of it
+    const off = Math.abs(fillerLocal.z) + 1.4;
+    const tx = T.x - fx * fillerLocal.x + rx * off * side;
+    const tz = T.z - fz * fillerLocal.x + rz * off * side;
+    await ev(([x, z]) => window.__rt.journey.driveTo(x, z, 45, 40), tx - fx * 14, tz - fz * 14);
+    const r = await ev(([x, z]) => window.__rt.journey.driveTo(x, z, 12, 30), tx, tz);
+    return { ...r, target: [tx, tz] };
+  }, (g) => (g.dist < 4 && g.kmh < 1 ? true : 'did not stop on the pad by the tank'));
+
+  await step('handbrake_engine_off', async () => {
+    await ev(() => window.__rt.sys.handbrake(true));
+    await ev(() => window.__rt.sys.key('off'));
+    const t = await tele();
+    return { handbrake: t.handbrake, engineOn: t.engineOn, selector: t.selector };
+  }, (g) => (g.handbrake && !g.engineOn ? true : 'handbrake not on or engine still running'));
+
+  await step('get_out', async () => ev(() => window.__rt.footOut()), (m) => (m === 'onfoot' ? true : `mode ${m}`));
+
+  // ---- walk to the filler and pump petrol from the station's tank
+  const spec = (await tele()).vehicle;
+  const walkTo = async (id, stopAt = 1.1) => {
+    for (let k = 0; k < 4; k++) {
+      const a = await ev(([i]) => window.__rt.journey.aimOf(i), id);
+      if (!a) return null;
+      const f = await ev(() => window.__rt.footState());
+      const d = Math.hypot(a.x - f.x, a.z - f.z);
+      if (d <= stopAt + 0.15) break;
+      await ev(([s, h]) => window.__rt.footWalk(s, 1, 0, h), (d - stopAt) / 1.3, Math.atan2(a.z - f.z, a.x - f.x));
+    }
+    {
+      // still not there (something in the straight line; the harness has no path-finding): stand there
+      const a = await ev(([i]) => window.__rt.journey.aimOf(i), id);
+      const f = await ev(() => window.__rt.footState());
+      const d = Math.hypot(a.x - f.x, a.z - f.z);
+      if (d > stopAt + 0.6) {
+        const h = Math.atan2(a.z - f.z, a.x - f.x);
+        await ev(([x, z, hh]) => window.__rt.footAt(x, z, hh), a.x - Math.cos(h) * stopAt, a.z - Math.sin(h) * stopAt, h);
+        say(`note: walking to ${id} was blocked on the straight line; stood there instead`);
+      }
+    }
+    await ev(([i]) => window.__rt.journey.faceUse(i), id);
+    return ev(() => window.__rt.footLooked());
+  };
+  const fuel0 = (await sys()).fuelL;
+  await step('walk_to_filler', async () => walkTo(`${spec}:filler`), (g) => (g && g.id === `${spec}:filler` && g.word === '加油' ? true : `looking at ${g?.id} "${g?.word}"`));
+  await step('pump_petrol', async () => {
+    const h = await ev(() => window.__rt.footHold(16));
+    const s = await sys();
+    const d = await ev(() => window.__rt.sys.dash());
+    return { fuelL: s.fuelL, needle: d.fuel, word: h.word };
+  }, (g) => (g.fuelL > fuel0 + 8 ? true : `tank ${fuel0.toFixed(1)} → ${g.fuelL.toFixed(1)} L`));
+
+  // ---- the station's toolbox and counter: open, take all
+  const boxes = st.containers.filter((c) => c.kind === 'toolbox' || c.kind === 'counter');
+  for (const c of boxes) {
+    await step(`search_${c.kind}`, async () => {
+      // where one stands to search it: in front of it (a container's front is its −v side)
+      const fx = c.x + Math.sin(c.yaw) * (c.hz + 0.75);
+      const fz = c.z - Math.cos(c.yaw) * (c.hz + 0.75);
+      const f = await ev(() => window.__rt.footState());
+      await ev(([s, h]) => window.__rt.footWalk(s, 1, 0, h), Math.hypot(fx - f.x, fz - f.z) / 1.3, Math.atan2(fz - f.z, fx - f.x));
+      const g = await ev(() => window.__rt.footState());
+      let how = 'walked';
+      if (Math.hypot(fx - g.x, fz - g.z) > 0.8) {
+        // a straight walk does not find the door (the harness has no path-finding): stand there instead
+        await ev(([x, z]) => window.__rt.footAt(x, z, 0), fx, fz);
+        how = 'stood there (a wall in the straight line)';
+      }
+      await ev(([i]) => window.__rt.footFaceThing(i), c.id);
+      const opened = await ev(() => window.__rt.footHold(1.7));
+      // look at one of the things lying in it and hold E: take all that fits
+      const inside = await ev(([i]) => window.__rt.journey.containerSlots(i), c.id);
+      let took = { word: null };
+      if (inside && inside.slots.length) {
+        await ev(([i]) => window.__rt.journey.faceUse(i), `${c.id}#${inside.slots[0].i}`);
+        took = await ev(() => window.__rt.footHold(1.0));
+      }
+      const p = await ev(() => window.__rt.footState());
+      return { how, opened: opened.word, inside: inside?.slots.map((x) => `${x.id}×${x.n}`).join(' '), took: took.word, pack: p.pack.map((x) => `${x.id}×${x.n}`).join(' '), hands: p.hands };
+    }, (g) => (g.pack.length > 0 || g.hands ? true : 'nothing came out of it'));
+  }
+  const pack = failed ? [] : (await ev(() => window.__rt.footState())).pack;
+  if (!failed && !pack.some((x) => x.id === 'tool.repairkit')) {
+    say(`note: this seed's station boxes hold no repair kit — one is given through __rt.journey.give`);
+    await ev(() => window.__rt.journey.give('tool.repairkit'));
+  }
+
+  // ---- at the car: the bonnet (if the model has one), the engine, the flat
+  const movers = await ev(() => Object.keys(window.__rt.game.view.parts.movers));
+  const bonnet = movers.find((m) => /bonnet|hood/i.test(m));
+  if (bonnet) await ev(([m]) => window.__rt.setMover(m, 1), bonnet);
+  else if (!failed) say('note: the truck model has no bonnet mover — the places under it are reachable (fallback)');
+  const eng0 = (await sys()).slots.engine.cond;
+  await step('walk_to_engine', async () => walkTo(`${spec}:engine`, 1.2), (g) => (g && g.word === '修理' ? true : `looking at ${g?.id} "${g?.word}"`));
+  await step('repair_engine', async () => {
+    await ev(() => window.__rt.footHold(12.6));
+    return { engine: (await sys()).slots.engine.cond };
+  }, (g) => (g.engine >= eng0 + 49 ? true : `engine ${eng0} → ${g.engine}`));
+  await step('walk_to_flat', async () => walkTo(`${spec}:wheel1`, 1.0), (g) => (g && g.word === '换备胎' ? true : `looking at ${g?.id} "${g?.word}"`));
+  await step('change_wheel', async () => {
+    await ev(() => window.__rt.footHold(20.5));
+    const s = await sys();
+    return { wheel1: s.wheels[1], spare: s.spare };
+  }, (g) => (!g.wheel1.flat && !g.wheel1.off && g.spare && g.spare.flat ? true : 'wheel not changed'));
+  await step('flat_on_carrier_plugged', async () => {
+    const w = await walkTo(`${spec}:spare`, 1.0);
+    if (w?.word === '补胎') await ev(() => window.__rt.footHold(25.5));
+    const s = await sys();
+    return { word: w?.word, spare: s.spare };
+  }, (g) => (g.spare && !g.spare.flat ? true : `the flat is on the carrier but not mended (${g.word})`));
+
+  // ---- back in, start, go
+  await step('get_in', async () => {
+    const w = await walkTo(`${spec}:door:driver`, 0.9);
+    await ev(() => window.__rt.footUse());
+    return { word: w?.word, mode: (await ev(() => window.__rt.footState())).mode };
+  }, (g) => (g.mode !== 'onfoot' ? true : `still on foot (word "${g.word}")`));
+  await step('start_and_go', async () => {
+    const running = await ev(() => window.__rt.sys.crank(3));
+    await ev(() => window.__rt.sys.handbrake(false));
+    for (let k = 0; k < 3; k++) await ev(() => window.__rt.sys.lever(1));
+    const x0 = (await tele()).s;
+    await ev(() => window.__rt.simulate(30, 'robot'));
+    const t = await tele();
+    return { running, selector: t.selector, kmh: t.kmh, metres: t.s - x0, fuel: t.fuel };
+  }, (g) => (g.running && g.selector === 'D' && g.kmh > 30 && g.metres > 300 ? true : 'did not drive off'));
+} catch (e) {
+  failed = true;
+  say(`FAIL exception: ${String(e).slice(0, 600)}`);
+} finally {
+  fs.writeFileSync(path.join(outDir, 'journey.log'), log.join('\n') + '\n');
+  await browser.close();
+  await server.close();
+}
+say(failed ? 'journey FAILED' : `journey ok in ${((Date.now() - t0) / 1000).toFixed(0)} s`);
+process.exit(failed ? 1 : 0);
