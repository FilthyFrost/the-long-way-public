diff --git a/src/core/vehicle/systems/recover.ts b/src/core/vehicle/systems/recover.ts
new file mode 100644
index 0000000..b17517a
--- /dev/null
+++ b/src/core/vehicle/systems/recover.ts
@@ -0,0 +1,146 @@
+/**
+ * "一键回到路上" (docs/DESIGN_V2.md 5.6, docs/VEHICLE_SYSTEMS.md §7.4): a vehicle rolled over, stuck or
+ * in the water is put back on the road. With nobody in it, holding E at its tow hook for 3 s puts it
+ * on the nearest road point within 300 m — upright, along the road, stopped, handbrake on, clear of
+ * every solid, off bridge decks and the mouths of places where that can be helped.
+ *
+ * Pure: the world is asked through a narrow interface (the road spine, the land, the solids), so it
+ * is tested headless; the game's tow hook calls it (src/game/systems/carPlaces.ts).
+ */
+import type { VehicleSim } from '../sim';
+import type { VehicleSpec } from '../spec';
+import { Push, pushOut, type Solid, type SolidSource } from '../../world/solids';
+import { SpineSample } from '../../world/spine';
+
+/** how far the road may be (m) */
+export const RECOVER_REACH = 300;
+/** seconds of holding E at the tow hook */
+export const RECOVER_HOLD = 3;
+/** the lane the vehicle is put in (m right of the centre line) */
+const LANE = 1.6;
+
+export interface RecoverPoint {
+  h: number;
+  /** 0…1 on a bridge span; 0…1 on a place's levelled ground; water level (−Infinity = none) */
+  bridge: number;
+  site: number;
+  wl: number;
+}
+
+export interface RecoverWorld {
+  spine: {
+    project(x: number, z: number, hint: number, out: { s: number; d: number }): void;
+    at(s: number, out: SpineSample): void;
+  };
+  /** the land at a point (terrain.ts World.shape fills a TerrainPoint with these and more) */
+  shape(x: number, z: number, o: RecoverPoint): void;
+}
+
+export interface RecoverSpot {
+  ok: boolean;
+  /** why not: 'far' (no road within reach), 'blocked' (no free stretch) */
+  reason: string;
+  s: number;
+  x: number;
+  y: number;
+  z: number;
+  /** heading about +y as VehicleSim.reset takes it */
+  yaw: number;
+  /** compromises taken: on a bridge, on a place's ground */
+  onBridge: boolean;
+  onSite: boolean;
+}
+
+/** does the body footprint at (x, z, heading phi along the road) touch a solid? */
+function blocked(spec: VehicleSpec, x: number, z: number, phi: number, y: number, solids: SolidSource | null, near: Solid[], push: Push): boolean {
+  if (!solids) return false;
+  const bd = spec.body;
+  near.length = 0;
+  solids.solidsNear(x, z, bd.halfLength + 1, near);
+  const fx = Math.cos(phi);
+  const fz = Math.sin(phi);
+  const r = bd.halfWidth + 0.15;
+  const n = Math.max(2, Math.ceil((2 * bd.halfLength) / bd.halfWidth));
+  for (const s of near) {
+    if (s.tag === spec.id || s.tag.startsWith(spec.id + ':')) continue;
+    if (s.y1 <= y + bd.bottom + spec.cgHeight + 0.05 || s.y0 >= y + spec.cgHeight + bd.top) continue;
+    for (let i = 0; i < n; i++) {
+      const u = bd.centerX - bd.halfLength + bd.halfWidth + ((2 * (bd.halfLength - bd.halfWidth)) * i) / (n - 1);
+      if (pushOut(s, x + fx * u, z + fz * u, r, push)) return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * Where to put the vehicle back: the nearest road point to (x, z), then stepping along the road
+ * (4 m at a time, both ways, up to 160 m) until the body is clear of every solid, preferring a spot
+ * that is neither on a bridge deck nor on a place's levelled ground.
+ */
+export function findRecoverySpot(world: RecoverWorld, spec: VehicleSpec, x: number, z: number, solids: SolidSource | null, hint = NaN): RecoverSpot {
+  const pr = { s: 0, d: 0 };
+  world.spine.project(x, z, hint, pr);
+  const sp = new SpineSample();
+  const tp: RecoverPoint = { h: 0, bridge: 0, site: 0, wl: -Infinity };
+  const out: RecoverSpot = { ok: false, reason: 'far', s: pr.s, x, y: 0, z, yaw: 0, onBridge: false, onSite: false };
+  world.spine.at(pr.s, sp);
+  if (Math.hypot(sp.x - x, sp.z - z) > RECOVER_REACH) return out;
+  const near: Solid[] = [];
+  const push = new Push();
+  let fallback: RecoverSpot | null = null;
+  for (let k = 0; k <= 80; k++) {
+    const ds = (k % 2 === 1 ? 1 : -1) * Math.ceil(k / 2) * 4;
+    const s = pr.s + ds;
+    if (s < 1) continue;
+    world.spine.at(s, sp);
+    // the right-hand lane, heading along the road (phi: the road's heading on the plan, as (cos, sin))
+    const px = sp.x - Math.sin(sp.phi) * LANE;
+    const pz = sp.z + Math.cos(sp.phi) * LANE;
+    world.shape(px, pz, tp);
+    const y = tp.h;
+    if (tp.wl > y) continue; // never into water
+    if (blocked(spec, px, pz, sp.phi, y, solids, near, push)) continue;
+    const onBridge = tp.bridge > 0.01;
+    const onSite = tp.site > 0.01;
+    const spot: RecoverSpot = { ok: true, reason: '', s, x: px, y, z: pz, yaw: -sp.phi, onBridge, onSite };
+    if (!onBridge && !onSite) return spot;
+    if (!fallback) fallback = spot;
+  }
+  if (fallback) return fallback;
+  out.reason = 'blocked';
+  return out;
+}
+
+/** put the vehicle there: upright, stopped, handbrake on (P in relaxed controls is the caller's call) */
+export function placeAtSpot(sim: VehicleSim, spot: RecoverSpot): void {
+  sim.reset(spot.x, spot.y + 0.05, spot.z, spot.yaw);
+  sim.setParkBrake(true);
+}
+
+export type Plight = 'ok' | 'rolled' | 'stuck' | 'water';
+
+/**
