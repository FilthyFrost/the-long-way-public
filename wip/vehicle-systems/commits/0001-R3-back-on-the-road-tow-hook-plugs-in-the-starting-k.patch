+/**
+ * Hooks for the journey smoke run (harness/shots/journey.mjs): find a station ahead, drive the car
+ * onto its pad by scripted inputs through the normal input path, stand and look at a thing by its
+ * interactable id, give an item when a seed's boxes hold none (logged by the script). Everything
+ * else the run does goes through the player base's foot hooks and __rt.sys.
+ */
+import type { Game } from '../game';
+
+export function journeyHooks(game: Game) {
+  const settle = (): void => game.simulate(0);
+  const b = new Float64Array(9);
+  return {
+    /** the first station between s0 and s1: its anchor, its tank's hose point, its containers */
+    findStation: (s0 = 0, s1 = 40000) => {
+      const w = game.world;
+      if (!w) return null;
+      const sites = w.sites.between(s0, s1, []);
+      sites.sort((a, c) => a.s - c.s);
+      const st = sites.find((x) => x.kind === 'station' && x.fuel.some((f) => f.from === 'tank'));
+      if (!st) return null;
+      const tank = st.fuel.find((f) => f.from === 'tank')!;
+      return {
+        id: st.id,
+        s: st.s,
+        side: st.side,
+        x: st.x,
+        z: st.z,
+        tank: { id: tank.id, x: tank.x, y: tank.y, z: tank.z, litres: tank.litres },
+        containers: st.containers.map((c) => ({ id: c.id, kind: c.kind, x: c.x, y: c.y, z: c.z, yaw: c.yaw, hx: c.hx, hz: c.hz })),
+      };
+    },
+    /**
+     * Drive to a world point by steering at it (pure pursuit on the point) and stop there, through the
+     * same VehicleInput the keys give. Returns where the car stopped and how far from the point.
+     */
+    driveTo: (x: number, z: number, maxKmh = 25, timeout = 60) => {
+      const sim = game.sim;
+      const dt = 1 / 30;
+      for (let t = 0; t < timeout; t += dt) {
+        sim.basis(b);
+        const fx = b[0];
+        const fz = b[2];
+        const dx = x - sim.px;
+        const dz = z - sim.pz;
+        const dist = Math.hypot(dx, dz);
+        const ahead = dx * fx + dz * fz;
+        const right = dx * -fz + dz * fx;
+        if (dist < 0.6 || (ahead < 0 && dist < 3)) break;
+        const steer = Math.max(-1, Math.min(1, Math.atan2(right, Math.max(0.5, ahead)) * 2.2));
+        const want = Math.min(maxKmh, 4 + dist * 3) / 3.6;
+        const v = sim.vForward;
+        game.simulate(dt, { steer, throttle: v < want ? 0.45 : 0, brake: v > want + 1 ? 0.5 : 0 });
+      }
+      // stop
+      for (let t = 0; t < 6 && game.sim.speed > 0.05; t += dt) game.simulate(dt, { brake: game.sim.speed > 0.3 ? 1 : 0 });
+      settle();
+      return { x: game.sim.px, z: game.sim.pz, dist: Math.hypot(x - game.sim.px, z - game.sim.pz), kmh: game.sim.kmh };
+    },
+    /** a body-frame point of the car in the world (to aim the parking at the filler) */
+    bodyPoint: (x: number, y: number, z: number) => {
+      const sim = game.sim;
+      sim.basis(b);
+      return { x: sim.px + b[0] * x + b[3] * y + b[6] * z, y: sim.py + b[1] * x + b[4] * y + b[7] * z, z: sim.pz + b[2] * x + b[5] * y + b[8] * z, yaw: Math.atan2(b[2], b[0]) };
+    },
+    /** the aim point of an interactable near the player (a car place, the filler, a door) */
+    aimOf: (id: string) => {
+      const p = game.player;
+      const it = p.interact.find(id, p.walker.x, p.walker.z, 12);
+      if (!it) return null;
+      const o = { x: 0, y: 0, z: 0 };
+      it.aim(o);
+      return o;
+    },
+    /** turn the walker to look straight at an interactable (from where it stands) */
+    faceUse: (id: string) => {
+      const p = game.player;
+      const it = p.interact.find(id, p.walker.x, p.walker.z, 12);
+      if (!it) return false;
+      const o = { x: 0, y: 0, z: 0 };
+      it.aim(o);
+      p.walker.eye(p.eye);
+      const dx = o.x - p.eye.x;
+      const dz = o.z - p.eye.z;
+      p.walker.heading = Math.atan2(dz, dx);
+      p.walker.pitch = Math.atan2(o.y - p.eye.y, Math.hypot(dx, dz));
+      game.input.lookYaw = p.walker.heading;
+      game.input.lookPitch = p.walker.pitch;
+      settle();
+      return true;
+    },
+    /** the slots of an open container that hold something (their interactable ids are `${id}#${i}`) */
+    containerSlots: (id: string) => {
+      const c = game.player.containers.get(id);
+      if (!c) return null;
+      return { opened: c.opened, slots: c.store.slots.map((s, i) => (s ? { i, id: s.id, n: s.n } : null)).filter((x) => x !== null) };
+    },
+    /** debug: tip the car over into the verge (offset m to its right, on its side) and let it settle */
+    tip: (offset = 12) => {
+      const sim = game.sim;
+      sim.basis(b);
+      sim.px += b[6] * offset;
+      sim.pz += b[8] * offset;
+      const yaw = sim.yaw;
+      const r = (100 * Math.PI) / 180;
+      const cy = Math.cos(yaw / 2);
+      const sy = Math.sin(yaw / 2);
+      const cr = Math.cos(r / 2);
+      const sr = Math.sin(r / 2);
+      // yaw about +y, then roll about the body's +x
+      sim.qx = cy * sr;
+      sim.qy = sy * cr;
+      sim.qz = -sy * sr;
+      sim.qw = cy * cr;
+      sim.vx = sim.vy = sim.vz = 0;
+      sim.avx = sim.avy = sim.avz = 0;
+      sim.py += 1.2;
+      game.simulate(3);
+      return { plight: game.systems.plight, message: game.systems.dash.message.code };
+    },
+    /** the tow hook's effect without walking to it (the journey run walks to it) */
+    recover: () => {
+      const ok = game.carPlaces.recover();
+      game.simulate(1);
+      return { ok, plight: game.systems.plight, wheels: game.sim.wheels.map((w) => w.contact) };
+    },
+    /** debug: put an item in the backpack (or the hands) — the run logs when it had to */
+    give: (id: string, cond?: number) => {
+      const p = game.player;
+      const ok = p.pack.add(id, 1, cond !== undefined ? { cond } : undefined) === 0 || (p.hands.empty && (p.hands.set(id, 0, cond), true));
+      settle();
+      return ok;
+    },
+  };
+}
