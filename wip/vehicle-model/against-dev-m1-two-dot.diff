+def crop(name, box):
+    """a part of a reference picture: box = (x0, y0, x1, y1) as fractions of its size"""
+    path = os.path.join(refs_dir, name)
+    if not os.path.exists(path):
+        return None
+    im = Image.open(path)
+    w, h = im.size
+    return im.crop((round(box[0] * w), round(box[1] * h), round(box[2] * w), round(box[3] * h)))
+
+
+# 1. the reference pairs (the crops frame the matching drawing on each sheet)
