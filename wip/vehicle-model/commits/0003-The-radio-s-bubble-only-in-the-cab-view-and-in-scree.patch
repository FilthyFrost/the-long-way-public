diff --git a/src/game/vehicle/controls.ts b/src/game/vehicle/controls.ts
index d10c3a8..c545244 100644
--- a/src/game/vehicle/controls.ts
+++ b/src/game/vehicle/controls.ts
@@ -119,6 +119,7 @@ export class CabControls implements InteractSource {
   private hopV = 0;
   private rattleT = 0;
   private bubbleEl: HTMLDivElement | null = null;
+  private bubbleInShots: boolean | null = null;
   glovebox: Container | null = null;
   private readonly b = new Float64Array(9);
   private readonly p = { x: 0, y: 0, z: 0 };
@@ -406,7 +407,10 @@ export class CabControls implements InteractSource {
       document.body.appendChild(el);
       this.bubbleEl = el;
     }
-    const show = this.bubble !== '' && !this.game.player?.onFoot;
+    // only from inside the cab; in screenshot mode only when the shot asks for it (URL `bubble=1`)
+    if (this.bubbleInShots === null) this.bubbleInShots = new URLSearchParams(location.search).get('bubble') === '1';
+    const shotMode = this.game.params?.shot === true;
+    const show = this.bubble !== '' && !this.game.player?.onFoot && this.game.viewMode === 'cockpit' && (!shotMode || this.bubbleInShots);
     this.bubbleEl.style.display = show ? 'block' : 'none';
     if (show) this.bubbleEl.textContent = `收音机：${this.bubble}`;
   }
