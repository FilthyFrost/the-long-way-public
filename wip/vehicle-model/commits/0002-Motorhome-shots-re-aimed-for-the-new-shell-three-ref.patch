     a = Image.open(ours).convert('RGB')
-    b = Image.open(os.path.join(refs_dir, ref)).convert('RGB')
+    b = ref_img.convert('RGB')
     a = a.resize((round(a.width * H / a.height), H), Image.LANCZOS)
     b = b.resize((round(b.width * H / b.height), H), Image.LANCZOS)
     sheet = Image.new('RGB', (a.width + b.width + 12, H), (22, 25, 30))
     sheet.paste(a, (0, 0))
     sheet.paste(b, (a.width + 12, 0))
     d = ImageDraw.Draw(sheet)
-    for x, text in [(0, s), (a.width + 12, ref)]:
+    for x, text in [(0, shot), (a.width + 12, ref_label)]:
         d.rectangle([x, 0, x + 10 + 7 * len(text), 20], fill=(0, 0, 0))
         d.text((x + 5, 4), text, fill=(255, 255, 255))
-    out = os.path.join(out_dir, s + '.jpg')
+    out = os.path.join(out_dir, out_name + '.jpg')
     sheet.save(out, quality=88)
     print(out)
+
+
+def crop(name, box):
+    """a part of a reference picture: box = (x0, y0, x1, y1) as fractions of its size"""
+    path = os.path.join(refs_dir, name)
+    if not os.path.exists(path):
+        return None
+    im = Image.open(path)
+    w, h = im.size
+    return im.crop((round(box[0] * w), round(box[1] * h), round(box[2] * w), round(box[3] * h)))
+
+
+# 1. the reference pairs (the crops frame the matching drawing on each sheet)
+REF_PAIRS = [
+    ('rv_ref_front34', 'chris-bennett-van-fin.jpg', (0.02, 0.0, 0.6, 0.56), 'reference: exterior'),
+    ('rv_ref_cutaway', 'chris-bennett-van-fin.jpg', (0.44, 0.36, 1.0, 1.0), 'reference: cutaway'),
+    ('rv_ref_model', 'chris-bennett-3d-model-van.jpg', (0.0, 0.0, 1.0, 1.0), 'reference: blocking model'),
+]
+used = set()
+for shot, name, box, label in REF_PAIRS:
+    im = crop(name, box)
+    if im is None:
+        print(f'{shot}: {name} is not in {os.path.relpath(refs_dir, ROOT)}')
+        continue
+    used.add(name)
+    pair(shot, im, label, shot)
+
+# 2. the older pairs, with whatever pictures are left
+shots = ['rv_front34', 'rv_side_right', 'rv_cutaway_side', 'rv_room_rear']
+unused = [r for r in refs if r not in used and not any(r.startswith(s) for s in shots)]
+for s in shots:
+    named = [r for r in refs if r.startswith(s)]
+    ref = named[0] if named else (unused.pop(0) if unused else None)
+    if ref is None:
+        print(f'{s}: no reference left to pair with')
+        continue
+    pair(s, Image.open(os.path.join(refs_dir, ref)), ref, s)
