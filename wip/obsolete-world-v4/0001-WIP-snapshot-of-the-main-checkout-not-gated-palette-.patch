+      const p = this.pos;
+      const ux = p[i + 3] - p[i];
+      const uy = p[i + 4] - p[i + 1];
+      const uz = p[i + 5] - p[i + 2];
+      const vx = p[i + 6] - p[i];
+      const vy = p[i + 7] - p[i + 1];
+      const vz = p[i + 8] - p[i + 2];
+      const nx = uy * vz - uz * vy;
+      const ny = uz * vx - ux * vz;
+      const nz = ux * vy - uy * vx;
+      const l = Math.hypot(nx, ny, nz) || 1;
