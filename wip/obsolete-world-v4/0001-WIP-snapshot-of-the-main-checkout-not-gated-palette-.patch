+            if (tp.wl > -1e8 && tp.wl > tp.bed - 0.3 && b <= W) wet = true;
+            if (b > W) {
+              // (towards a lake the land is meant to fall: only rising ground has to be cut)
+              const dh = tp.bed - padH;
