+/**
+ * What a vehicle carries outside its seats, and how it stands in the way of walkers.
+ *
+ * Shape: most vehicles are one box (spec.body); the open truck is a bed one can stand on — a floor
+ * at its deck, low side walls, a tailgate, a headboard — and a cab.
+ *
+ * Cargo (docs/DESIGN_V2.md 6.4, 8.1 "货位"): medium and large things — a jerrycan, a tyre, a
+ * generator — put down on the truck's bed, on the van's rear deck, on the motorhome's rear carrier.
+ * A slot store per vehicle (`Inventory(n, BIG_ONLY)`) with a place for each slot; the things ride
+ * there (they stay put while driving, for now: 5.6's sliding loads are a later package).
+ *
+ * Everything is in the body frame: +x forward, +y up, +z right, origin at the centre of gravity.
+ */
+import type { VehicleSpec } from '../vehicle/spec';
+import { item } from '../items/catalog';
+import { BIG_ONLY, Inventory, type Stack } from '../items/inventory';
+import { canTake, take, takeWord } from '../items/carry';
+import { pickRadius, sizeOf } from '../items/shapes';
+import type { Actor, Interactable, InteractSource, Vec3 } from '../interact/interact';
+import { bodyToWorld, type VehiclePose } from './vehicle';
+
+/** one upright box of a vehicle's body (body frame, y relative to the centre of gravity) */
+export interface BodyBox {
+  x0: number;
+  x1: number;
+  z0: number;
+  z1: number;
+  y0: number;
+  y1: number;
+  floor: boolean;
+}
+
+export interface CargoSpec {
+  /** where each slot's thing stands: body frame, y = the surface it stands on */
+  places: { x: number; y: number; z: number }[];
+  /** the point one looks at to put something on */
+  access: { x: number; y: number; z: number };
+  /** the bed can be climbed onto: where one ends up standing (body frame x, z) and where one looks to climb */
+  climb?: { x: number; z: number; aim: { x: number; y: number; z: number } };
+  /** a steel carrier is drawn under the places (the motorhome's rear rack) */
+  carrier?: { x0: number; x1: number; z: number; y: number };
+}
+
+/** the open truck as boxes: bed floor, walls, tailgate, headboard, cab (from game/vehicle/truck.ts) */
+function truckBoxes(spec: VehicleSpec): BodyBox[] {
+  const H = (h: number): number => h - spec.cgHeight;
+  return [
+    { x0: -1.6, x1: 0.15, z0: -0.7, z1: 0.7, y0: H(0.3), y1: H(0.64), floor: true }, // the bed's deck
+    { x0: -1.6, x1: 0.15, z0: -0.72, z1: -0.64, y0: H(0.64), y1: H(0.95), floor: false }, // walls
+    { x0: -1.6, x1: 0.15, z0: 0.64, z1: 0.72, y0: H(0.64), y1: H(0.95), floor: false },
+    { x0: -1.62, x1: -1.54, z0: -0.7, z1: 0.7, y0: H(0.4), y1: H(0.94), floor: false }, // tailgate
+    { x0: 0.12, x1: 0.2, z0: -0.7, z1: 0.7, y0: H(0.64), y1: H(1.06), floor: false }, // headboard
+    { x0: 0.19, x1: 1.7, z0: -0.7, z1: 0.7, y0: spec.body.bottom, y1: spec.body.top, floor: false }, // the cab
+  ];
+}
+
+/** the boxes a vehicle stands in the way with */
+export function bodyBoxes(spec: VehicleSpec): BodyBox[] {
+  if (spec.id === 't0_truck') return truckBoxes(spec);
+  const b = spec.body;
+  return [{ x0: b.centerX - b.halfLength, x1: b.centerX + b.halfLength, z0: -b.halfWidth, z1: b.halfWidth, y0: b.bottom, y1: b.top, floor: false }];
+}
+
+/** where each vehicle carries big things (none: it has no such place) */
+export function cargoOf(spec: VehicleSpec): CargoSpec | null {
+  const H = (h: number): number => h - spec.cgHeight;
+  switch (spec.id) {
+    case 't0_truck':
+      return {
+        places: [
+          { x: -1.25, y: H(0.64), z: -0.33 },
+          { x: -1.25, y: H(0.64), z: 0.33 },
+          { x: -0.55, y: H(0.64), z: -0.33 },
+          { x: -0.55, y: H(0.64), z: 0.33 },
+        ],
+        access: { x: -1.0, y: H(0.75), z: 0 },
+        climb: { x: -0.9, z: 0, aim: { x: -1.58, y: H(0.9), z: 0 } },
+      };
+    case 't1_van':
+      // the rear deck over the engine, reached through the tailgate
+      return {
+        places: [
+          { x: -1.78, y: H(0.95), z: -0.32 },
+          { x: -1.78, y: H(0.95), z: 0.32 },
+        ],
+        access: { x: -2.0, y: H(1.1), z: 0 },
+      };
+    case 't3_rv':
+      // a steel carrier on the back, behind the rear wall
+      return {
+        places: [
+          { x: -3.55, y: H(0.62), z: -0.42 },
+          { x: -3.55, y: H(0.62), z: 0.42 },
+        ],
+        access: { x: -3.55, y: H(0.8), z: 0 },
+        carrier: { x0: -3.78, x1: -3.32, z: 0.82, y: H(0.62) },
+      };
+    default:
+      return null;
+  }
+}
+
+export interface CargoState {
+  store: (Stack | null)[];
+  fills: number[];
+}
+
+/** what one vehicle carries, and its uses: put on (放上车), take (拿 / 抬) */
+export class CargoBay implements InteractSource {
+  readonly store: Inventory;
+  /** litres in a vessel standing in each slot */
+  readonly fills: number[];
+  /** goes up whenever something is put on or taken (the view redraws then) */
+  version = 0;
+  private readonly b = new Float64Array(9);
+  private readonly put: Interactable;
+  private readonly slots: Interactable[];
+
+  constructor(
+    readonly vehicle: VehiclePose,
+    readonly spec: CargoSpec,
+  ) {
+    this.store = new Inventory(spec.places.length, BIG_ONLY);
+    this.fills = spec.places.map(() => 0);
+    const bay = this;
+    const tag = vehicle.spec.id;
+    this.put = {
+      id: `${tag}:cargo`,
+      hold: 0,
+      radius: 0.45,
+      through: tag,
+      aim(out: Vec3): void {
+        bodyToWorld(bay.vehicle, bay.b, bay.spec.access.x, bay.spec.access.y, bay.spec.access.z, out);
+      },
+      prompt(a: Actor): string | null {
+        return a.hands.id && bay.store.room(a.hands.id) > 0 ? '放上车' : null;
+      },
+      act(a: Actor): boolean {
+        return bay.putFrom(a);
+      },
+    };
+    this.slots = spec.places.map((p, i) => ({
+      id: `${tag}:cargo#${i}`,
+      hold: 0,
+      through: tag,
+      get radius(): number {
+        const s = bay.store.slots[i];
+        return s ? pickRadius(s.id) : 0.1;
+      },
+      aim(out: Vec3): void {
+        const s = bay.store.slots[i];
+        bodyToWorld(bay.vehicle, bay.b, p.x, p.y + (s ? sizeOf(s.id).h * 0.5 : 0), p.z, out);
+      },
+      prompt(a: Actor): string | null {
+        const s = bay.store.slots[i];
+        return s && canTake(a, s.id) > 0 ? takeWord(s.id) : null;
+      },
+      act(a: Actor): boolean {
+        return bay.takeInto(i, a);
+      },
+    }));
+  }
+
+  /** the thing in the hands onto the first free place */
+  putFrom(a: Actor): boolean {
+    const id = a.hands.id;
+    if (!id || this.store.room(id) <= 0) return false;
+    const i = this.store.slots.findIndex((s) => s === null);
+    if (i < 0) return false;
+    this.store.slots[i] = { id, n: 1 };
+    this.fills[i] = a.hands.fill;
+    a.hands.set(null);
+    this.version++;
+    return true;
+  }
+
+  /** slot i's thing into the hands */
+  takeInto(i: number, a: Actor): boolean {
+    const s = this.store.slots[i];
+    if (!s || canTake(a, s.id) <= 0) return false;
+    take(a, s.id, 1, this.fills[i]);
+    this.store.takeSlot(i, 1);
+    this.fills[i] = 0;
+    this.version++;
+    return true;
+  }
+
+  /** a body-frame place of slot i (for the view) */
+  place(i: number): { x: number; y: number; z: number } {
+    return this.spec.places[i];
+  }
+
+  interactablesNear(x: number, z: number, r: number, out: Interactable[]): void {
+    const v = this.vehicle;
+    const reach = r + v.spec.body.halfLength + 1.5;
+    if ((v.px - x) ** 2 + (v.pz - z) ** 2 > reach * reach) return;
+    out.push(this.put);
+    for (let i = 0; i < this.slots.length; i++) if (this.store.slots[i]) out.push(this.slots[i]);
+  }
+
+  toJSON(): CargoState {
+    return { store: this.store.toJSON(), fills: [...this.fills] };
+  }
+
+  load(s: CargoState): this {
+    this.store.load(s.store);
+    s.fills.forEach((f, i) => (this.fills[i] = f));
+    this.version++;
+    return this;
+  }
+}
+
+/** is a thing of this id carried as cargo at all (medium or large) */
+export function isCargo(id: string): boolean {
+  return item(id).size !== 'small';
+}
