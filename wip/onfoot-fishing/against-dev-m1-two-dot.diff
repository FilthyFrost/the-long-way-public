+    for (let i = 0; i < 800; i++) boxes.add({ id: `c${i}`, kind: 'crate', x: rnd() * 40000 - 20000, y: 0, z: rnd() * 400 - 200, heading: 0, seed: i, hx: 0.5, h: 0.6, hz: 0.4 });
+    // take a third away again
+    for (let i = 1; i <= 6000; i += 3) reg.take(`loose:${i}`);
+    for (const [x, z] of [
