diff --git a/harness/sim/fishing.test.ts b/harness/sim/fishing.test.ts
new file mode 100644
index 0000000..2b4b570
--- /dev/null
+++ b/harness/sim/fishing.test.ts
@@ -0,0 +1,181 @@
+/**
+ * Fishing (src/core/fishing, docs/DESIGN_V2.md 8.4, 11.2): who lives where and when, the bite
+ * window, the line that snaps after 1.5 s at full load, the same fish from the same seed and
+ * inputs, and robot anglers — a competent one lands its fish in 20–60 s, a careless one loses most.
+ */
+import { describe, expect, it } from 'vitest';
+import { Angling, BITE_WINDOW, BITE_WINDOW_RARE, FISH_STEP, SNAP_FULL, type FishInput, type RodTip } from '../../src/core/fishing/angling';
+import { School } from '../../src/core/fishing/school';
+import { slotOf, speciesFor, SPECIES } from '../../src/core/fishing/species';
+import { hasItem, item } from '../../src/core/items/catalog';
+import { LOOT } from '../../src/core/items/loot';
+import { FunctionLand } from '../../src/core/onfoot/land';
+import { fishFor, jetty } from './fishing';
+
+const ids = (water: 'lake' | 'stream' | 'oasis' | 'ice', hour: number, w?: Parameters<typeof speciesFor>[2]) => speciesFor(water, hour, w).map((s) => s.id).sort();
+
+describe('who lives where and when (11.2)', () => {
+  it('every lake at noon and at dusk offers what 11.2 says and nothing else', () => {
+    expect(ids('lake', 12)).toEqual(['fish.bleak', 'fish.carp', 'fish.crucian']);
+    expect(ids('lake', 18.5)).toEqual(['fish.bleak', 'fish.king', 'fish.perch']);
+  });
+  it('dawn, night, streams, the oasis, the weather', () => {
+    expect(ids('lake', 6)).toEqual(['fish.bleak', 'fish.pike']);
+    expect(ids('lake', 23)).toEqual(['fish.bleak', 'fish.catfish', 'fish.moon']);
+    expect(ids('lake', 23, { raining: false, wetness: 0, clear: false })).toEqual(['fish.bleak', 'fish.catfish']);
+    expect(ids('stream', 6)).toEqual(['fish.bleak', 'fish.trout']);
+    expect(ids('stream', 12, { raining: true, wetness: 1, clear: false })).toEqual(['fish.bleak', 'fish.eel']);
+    expect(ids('oasis', 12)).toEqual(['fish.barb']);
+    expect(ids('ice', 12)).toEqual(['fish.char']);
+    expect(slotOf(4.9)).toBe('night');
+    expect(slotOf(17)).toBe('dusk');
+  });
+  it('every fish is in the catalogue; the rod is a medium thing found in tackle boxes', () => {
+    for (const s of SPECIES) expect(hasItem(s.id)).toBe(true);
+    expect(item('tool.rod').size).toBe('medium');
+    expect(item('tool.rod').rarity).toBe(1);
+    expect(LOOT.tacklebox.entries.some((e) => e.id === 'tool.rod')).toBe(true);
+    expect(hasItem('keep.bottle')).toBe(true);
+  });
+});
+
+// a pond 2 m deep everywhere: the float lands in it wherever it goes
+const pond = new FunctionLand(
+  () => -2,
+  () => 0,
+);
+const tip = (): RodTip => ({ x: 0, y: 1.5, z: 0, heading: 0 });
+const idle = (): FishInput => ({ down: false, pullX: 0, pullY: 0, cancel: false });
+
+/** a rod with one shadow of `species` waiting beside where the float lands (8 m out) */
+function rigged(species = 'fish.crucian', seed = 3): { a: Angling; school: School } {
+  const school = new School(seed);
+  school.shadows.push({ id: 99, species, size: 0, lengthCm: 20, big: false, x: 8.0, z: 1.0, heading: 0, state: 'roam', t: 100, body: 0 });
+  const a = new Angling(seed, school);
+  const t = tip();
+  const inp = idle();
+  inp.down = true;
+  a.step(inp, t, pond);
+  const charge = Angling.chargeFor(8);
+  while (a.phase === 'charging' && a.t < charge) a.step(inp, t, pond);
+  inp.down = false;
+  while (a.phase !== 'waiting') a.step(inp, t, pond);
+  return { a, school };
+}
+
+function toBite(a: Angling): void {
+  const t = tip();
+  for (let i = 0; i < 60 * 40 && a.phase !== 'bite'; i++) a.step(idle(), t, pond);
+  expect(a.phase).toBe('bite');
+}
+
+describe('the cast and the bite', () => {
+  it('a 0.3–1.2 s charge throws 4–14 m', () => {
+    expect(Angling.castLength(0.1)).toBe(4);
+    expect(Angling.castLength(0.75)).toBeCloseTo(9, 6);
+    expect(Angling.castLength(2)).toBe(14);
+    const { a } = rigged();
+    // (the button is let go on the next step: a frame's worth of charge more)
+    expect(Math.abs(Math.hypot(a.fx, a.fz) - 8)).toBeLessThan(0.4);
+  });
+  it('struck within 0.9 s the fish is on; after it, it is gone', () => {
+    for (const [late, on] of [
+      [0.85, true],
+      [0.95, false],
+    ] as const) {
+      const { a } = rigged();
+      toBite(a);
+      const t = tip();
+      for (let i = 0; i < Math.round(late / FISH_STEP) - 1; i++) a.step(idle(), t, pond);
+      a.step({ ...idle(), down: true }, t, pond);
+      expect(a.phase === 'fight').toBe(on);
+    }
+    expect(BITE_WINDOW).toBe(0.9);
+  });
+  it('a rare fish gives 0.6 s', () => {
+    const { a } = rigged('fish.pike');
+    toBite(a);
+    expect(a.window).toBeCloseTo(BITE_WINDOW_RARE, 6);
+  });
+  it('striking before the bite loses the fish and nothing else', () => {
+    const { a, school } = rigged();
+    const t = tip();
+    for (let i = 0; i < 60 * 3; i++) a.step(idle(), t, pond);
+    expect(a.target).toBe(99);
+    a.step({ ...idle(), down: true }, t, pond);
+    expect(a.phase).toBe('idle');
+    expect(school.shadows[0].state).toBe('flee');
+  });
+});
+
+describe('the fight', () => {
+  function hooked(seed: number, species = 'fish.crucian'): Angling {
+    const { a } = rigged(species, seed);
+    toBite(a);
+    a.step({ ...idle(), down: true }, tip(), pond);
+    expect(a.phase).toBe('fight');
+    return a;
+  }
+  it('reeling hard through the runs snaps the line after 1.5 s at full load', () => {
+    for (let seed = 1; seed < 12; seed++) {
+      // a brute: its runs are long enough to load the line full
+      const a = hooked(seed, 'fish.perch');
+      const t = tip();
+      let fullFrom = -1;
+      let snapAt = -1;
+      for (let i = 0; i < 60 * 60 && a.phase === 'fight'; i++) {
+        // reel all the time, pulling the wrong way
+        const pull = a.run === 'left' ? -1 : a.run === 'right' ? 1 : a.run === 'out' ? -1 : 0;
+        a.step({ down: true, pullX: pull, pullY: a.run === 'out' ? -1 : 0, cancel: false }, t, pond);
+        if (a.events.includes('snap')) {
+          snapAt = a.clock;
+          break;
+        }
+        if (a.tension >= 0.999 && fullFrom < 0) fullFrom = a.clock - FISH_STEP;
+        if (a.tension < 0.999) fullFrom = -1;
+      }
+      if (snapAt < 0) continue; // it never ran long enough: not this seed
+      expect(snapAt - fullFrom).toBeGreaterThan(SNAP_FULL - 2 * FISH_STEP);
+      expect(snapAt - fullFrom).toBeLessThan(SNAP_FULL + 2 * FISH_STEP);
+      return;
+    }
+    throw new Error('no fish snapped the line');
+  });
+  it('the state saves and loads mid-fight and carries on the same', () => {
+    const a = hooked(4);
+    const t = tip();
+    for (let i = 0; i < 120; i++) a.step({ down: a.run === 'none', pullX: a.run === 'left' ? 1 : -1, pullY: 0, cancel: false }, t, pond);
+    const saved = JSON.parse(JSON.stringify({ a: a.toJSON(), s: a.school.toJSON() }));
+    const b = new Angling(0, new School(0).load(saved.s)).load(saved.a);
+    for (let i = 0; i < 600; i++) {
+      const inp = { down: a.run === 'none', pullX: a.run === 'left' ? 1 : -1, pullY: a.run === 'out' ? 1 : 0, cancel: false };
+      a.step(inp, t, pond);
+      b.step(inp, t, pond);
+    }
+    expect(JSON.stringify(b.toJSON())).toBe(JSON.stringify(a.toJSON()));
+  });
+});
+
+describe('robot anglers at seed 7\'s jetty', () => {
+  const place = jetty();
+  it('the same seed and the same inputs give the same fish', () => {
+    expect(JSON.stringify(fishFor('competent', 5, 3, undefined, place))).toBe(JSON.stringify(fishFor('competent', 5, 3, undefined, place)));
+  });
+  it('a competent angler lands its fish in 20–60 s and loses none', () => {
+    const s = fishFor('competent', 11, 10, undefined, place);
+    expect(s.catches.length).toBeGreaterThan(6);
+    const t = s.catches.map((c) => c.seconds).sort((x, y) => x - y);
+    expect(t[Math.floor(t.length / 4)]).toBeGreaterThan(18);
+    expect(t[Math.floor(t.length / 2)]).toBeLessThan(60);
+    expect(s.snaps).toBe(0);
+  });
+  it('a careless one loses most of what comes to its float', () => {
+    const s = fishFor('careless', 12, 10, undefined, place);
+    expect(s.catches.length / Math.max(1, s.catches.length + s.lost + s.snaps)).toBeLessThan(0.35);
+  });
+  it('at dusk the lake may give its old king, once', () => {
+    let kings = 0;
+    for (let k = 0; k < 3; k++) kings += fishFor('competent', 300 + k, 20, { hour: 18.5, weather: { raining: false, wetness: 0, clear: true } }, place).catches.filter((c) => c.id === 'fish.king').length;
+    expect(kings).toBeLessThanOrEqual(3);
+  });
+});
