+/**
+ * The truck's open bed and every vehicle's cargo places (src/core/onfoot/cargo.ts): climbed onto
+ * and stood on while parked, walls that keep one in, things put on and taken off with their litres.
+ */
+import { describe, expect, it } from 'vitest';
+import { Hands, newPack, take } from '../../src/core/items/carry';
+import { CargoBay, cargoOf } from '../../src/core/onfoot/cargo';
+import { FunctionLand } from '../../src/core/onfoot/land';
+import { VehicleSolid } from '../../src/core/onfoot/vehicle';
+import { FOOT, FootWalker } from '../../src/core/onfoot/walker';
+import { VEHICLES } from '../../src/core/vehicle/spec';
+import { VehicleSim } from '../../src/core/vehicle/sim';
+import { FlatGround } from '../../src/core/world/ground';
+import type { Actor } from '../../src/core/interact/interact';
+
+const flat = new FunctionLand(() => 0);
+
+function parked(id: string): VehicleSim {
+  const v = new VehicleSim(VEHICLES[id]);
+  v.reset(0, 0, 0, 0);
+  const g = new FlatGround();
+  for (let i = 0; i < 360; i++) v.substep({ steer: 0, throttle: 0, brake: 1, handbrake: 1 }, g);
+  return v;
+}
+
+const actor = (): Actor => ({ id: 'p', hands: new Hands(), pack: newPack(), eye: { x: 0, y: 1.6, z: 0 }, heading: 0 });
+
+describe('the truck bed', () => {
+  const v = parked('t0_truck');
+  const vs = new VehicleSolid(v);
+  const bedTop = v.py - v.spec.cgHeight + 0.64;
+  it('is not walked onto from the ground, nor jumped onto', () => {
+    const w = new FootWalker(flat, vs);
+    w.place(-4, 0, 0);
+    for (let i = 0; i < 600; i++) w.step({ forward: 1, right: 0, run: true, crouch: false, jump: i % 60 === 0 });
+    expect(w.y).toBeLessThan(0.05);
+    expect(w.x).toBeLessThan(-1.6 - FOOT.radius + 0.01);
+  });
+  it('once climbed onto, is stood on, and its walls keep one on it', () => {
+    const w = new FootWalker(flat, vs);
+    expect(w.place(-0.9, 0, 0, 0.5)).toBe(true);
+    expect(w.y).toBeCloseTo(bedTop, 2);
+    for (const heading of [Math.PI / 2, -Math.PI / 2, Math.PI, 0]) {
+      w.heading = heading;
+      for (let i = 0; i < 300; i++) w.step({ forward: 1, right: 0, run: false, crouch: false, jump: false });
+      expect(w.y).toBeCloseTo(bedTop, 2);
+      expect(w.insideSolid()).toBe(false);
+    }
+    // and jumped down from over the tailgate
+    w.heading = Math.PI;
+    for (let i = 0; i < 360; i++) w.step({ forward: 1, right: 0, run: false, crouch: false, jump: i % 30 === 0 && w.x > -1.7 });
+    expect(w.y).toBeLessThan(0.05);
+  });
+});
+
+describe('cargo', () => {
+  it('the truck, the van and the motorhome carry; the off-roader has no such place', () => {
+    expect(cargoOf(VEHICLES.t0_truck)?.places.length).toBe(4);
+    expect(cargoOf(VEHICLES.t1_van)?.places.length).toBe(2);
+    expect(cargoOf(VEHICLES.t3_rv)?.places.length).toBe(2);
+    expect(cargoOf(VEHICLES.t2_offroad)).toBe(null);
+  });
+  it('takes medium and large things with their litres, gives them back, saves and loads', () => {
+    const v = parked('t0_truck');
+    const bay = new CargoBay(v, cargoOf(v.spec)!);
+    const a = actor();
+    take(a, 'fuel.jerrycan', 1, 7.5);
+    expect(bay.putFrom(a)).toBe(true);
+    expect(a.hands.empty).toBe(true);
+    take(a, 'tyre.road');
+    expect(bay.putFrom(a)).toBe(true);
+    // a small thing is no cargo
+    take(a, 'food.can.beans');
+    a.hands.set('food.can.beans');
+    expect(bay.putFrom(a)).toBe(false);
+    a.hands.set(null);
+    const saved = JSON.parse(JSON.stringify(bay.toJSON()));
+    const again = new CargoBay(v, cargoOf(v.spec)!).load(saved);
+    expect(again.store.list().map((s) => s.id)).toEqual(['fuel.jerrycan', 'tyre.road']);
+    expect(again.takeInto(0, a)).toBe(true);
+    expect(a.hands.toJSON()).toEqual({ id: 'fuel.jerrycan', fill: 7.5 });
+    expect(again.takeInto(1, a)).toBe(false); // the hands are full
+    // full bay: the fifth thing does not go on
+    a.hands.set(null);
+    for (let i = 0; i < 4; i++) {
+      a.hands.set('tyre.road');
+      bay.putFrom(a);
+    }
+    expect(a.hands.id).toBe('tyre.road');
+  });
+});
