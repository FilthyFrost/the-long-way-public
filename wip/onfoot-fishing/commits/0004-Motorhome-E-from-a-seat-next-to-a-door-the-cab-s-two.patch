+/** a door within `reach` (m, on the plan) of a body-frame point — a seat beside it — or null */
+export function doorWithin(doors: readonly Door[], x: number, z: number, halfWidth: number, reach: number): Door | null {
+  let best: Door | null = null;
+  let bd = reach;
+  for (const d of doors) {
+    const dd = Math.hypot(d.x - x, d.side * halfWidth - z);
+    if (dd <= bd) {
+      bd = dd;
+      best = d;
+    }
+  }
+  return best;
+}
