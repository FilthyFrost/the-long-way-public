index 0000000..9b966da
--- /dev/null
+++ b/src/core/items/grid.ts
@@ -0,0 +1,59 @@
+/**
+ * A coarse grid on the plan for things that are added and taken but do not wander: loose things,
+ * containers. Asking for what is near a point visits the few cells round it, so a road that has
+ * handed over thousands of things still answers in microseconds.
+ */
+export const GRID_CELL = 16;
+
+export class CellIndex<T> {
+  private readonly cells = new Map<number, T[]>();
+  /** how far any one thing reaches beyond its point (a container's half size) */
+  private reach = 0;
+
+  constructor(readonly cell = GRID_CELL) {}
+
+  private key(i: number, j: number): number {
+    return (i + 1048576) * 2097152 + (j + 1048576);
+  }
+
+  add(t: T, x: number, z: number, reach = 0): void {
+    const k = this.key(Math.floor(x / this.cell), Math.floor(z / this.cell));
+    let l = this.cells.get(k);
+    if (!l) this.cells.set(k, (l = []));
+    l.push(t);
+    if (reach > this.reach) this.reach = reach;
+  }
+
+  remove(t: T, x: number, z: number): void {
+    const k = this.key(Math.floor(x / this.cell), Math.floor(z / this.cell));
+    const l = this.cells.get(k);
+    if (!l) return;
+    const i = l.indexOf(t);
+    if (i >= 0) l.splice(i, 1);
+    if (l.length === 0) this.cells.delete(k);
+  }
+
+  clear(): void {
+    this.cells.clear();
+    this.reach = 0;
+  }
+
+  /** call fn for everything in the cells that reach within r of (x, z) (the caller checks the distance) */
+  each(x: number, z: number, r: number, fn: (t: T) => void): void {
+    const rr = r + this.reach;
+    const i0 = Math.floor((x - rr) / this.cell);
+    const i1 = Math.floor((x + rr) / this.cell);
+    const j0 = Math.floor((z - rr) / this.cell);
+    const j1 = Math.floor((z + rr) / this.cell);
+    for (let i = i0; i <= i1; i++) {
+      for (let j = j0; j <= j1; j++) {
+        const l = this.cells.get(this.key(i, j));
+        if (l) for (const t of l) fn(t);
+      }
+    }
+  }
+
+  get cellCount(): number {
+    return this.cells.size;
+  }
+}
