+/** the hose that siphoning needs (8.1): in the backpack, or in the hands */
+export const HOSE = 'tool.siphon';
+
+export function hasHose(a: Actor): boolean {
+  return a.pack.count(HOSE) > 0 || a.hands.id === HOSE;
+}
+
 class Siphon implements Interactable {
   readonly hold = 0;
   readonly radius = 0.3;
@@ -44,6 +51,7 @@ class Siphon implements Interactable {
     const cap = a.hands.holds('fuel');
     if (cap <= 0) return null;
     if (this.f.litres <= 1e-6) return '空了';
+    if (!hasHose(a)) return '缺抽油管';
     return a.hands.fill < cap - 1e-6 ? '抽油' : '满了';
   }
   act(_a: Actor): boolean {
@@ -52,7 +60,7 @@ class Siphon implements Interactable {
   channel(a: Actor, dt: number): boolean {
     const cap = a.hands.holds('fuel');
     const room = cap - a.hands.fill;
-    if (cap <= 0 || room <= 1e-9 || this.f.litres <= 1e-9) return false;
+    if (cap <= 0 || room <= 1e-9 || this.f.litres <= 1e-9 || !hasHose(a)) return false;
     const l = Math.min(SIPHON_RATE[this.f.kind] * dt, room, this.f.litres);
     a.hands.fill += l;
     this.f.litres -= l;
