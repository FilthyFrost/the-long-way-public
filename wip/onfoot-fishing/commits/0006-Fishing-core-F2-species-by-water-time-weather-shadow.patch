+/**
+ * Robot anglers for the tests and the measurements: a competent one (casts at a shadow, waits for
+ * the real bite, strikes at once, pulls against every run and reels only while the fish rests) and
+ * a careless one (strikes at nibbles or late, keeps reeling, pulls any old way). They drive the
+ * same Angling a player does, through the same input.
+ */
+import { Angling, type FishInput, type RodTip } from './angling';
+import { Stream } from './school';
+
+export type AnglerKind = 'competent' | 'careless';
+
+export class Angler {
+  readonly input: FishInput = { down: false, pullX: 0, pullY: 0, cancel: false };
+  private readonly rng: Stream;
+  private charge = 0;
+  private react = 0;
+  private lastNibbles = 0;
+  private prev = false;
+
+  constructor(
+    readonly kind: AnglerKind,
+    seed: number,
+  ) {
+    this.rng = new Stream(seed ^ 0x7a11);
+  }
+
+  /** choose the input for this step; may turn the rod tip's heading to face a shadow before casting */
+  decide(a: Angling, tip: RodTip): FishInput {
+    const inp = this.input;
+    const careless = this.kind === 'careless';
+    inp.cancel = false;
+    inp.pullX = 0;
+    inp.pullY = 0;
+    switch (a.phase) {
+      case 'idle': {
+        // a shadow within reach: face it and charge for its distance
+        let best = null as null | { x: number; z: number; d: number };
+        for (const s of a.school.shadows) {
+          if (s.state !== 'roam') continue;
+          const d = Math.hypot(s.x - tip.x, s.z - tip.z);
+          if (d < 4.5 || d > 13.5) continue;
+          if (!best || d < best.d) best = { x: s.x, z: s.z, d };
+        }
+        if (!best) {
+          inp.down = false;
+          break;
+        }
+        tip.heading = Math.atan2(best.z - tip.z, best.x - tip.x);
+        // just short of it: right on top of it, the splash would scare it off
+        this.charge = Angling.chargeFor(best.d - 0.9 + (careless ? this.rng.range(-2.5, 2.5) : 0));
+        // (a fresh press: let go first if the button was still held from the fight)
+        inp.down = !this.prev;
+        break;
+      }
+      case 'charging':
+        inp.down = a.t < this.charge;
+        break;
+      case 'waiting':
+        inp.down = false;
+        if (careless && a.target) {
+          // strikes at a nibble half the time
+          const n = a.nibbles.length;
+          if (n < this.lastNibbles && this.rng.next() < 0.5) inp.down = true;
+          this.lastNibbles = n;
+        } else this.lastNibbles = 4;
+        // nothing came for a long while: wind in and cast again
+        if (!a.target && a.t > 12) inp.down = true;
+        this.react = careless ? this.rng.range(0.4, 1.4) : this.rng.range(0.18, 0.32);
+        break;
+      case 'bite':
+        inp.down = a.t >= this.react;
+        break;
+      case 'fight': {
+        if (careless) {
+          inp.down = true;
+          inp.pullX = this.rng.range(-1, 1);
+          inp.pullY = this.rng.range(-1, 1);
+          break;
+        }
+        const run = a.run;
+        inp.pullX = run === 'left' ? 1 : run === 'right' ? -1 : 0;
+        inp.pullY = run === 'out' ? 1 : 0;
+        inp.down = run === 'none' && a.tension < 0.8;
+        break;
+      }
+      case 'landed':
+        inp.down = false;
+        break;
+      default:
+        inp.down = false;
+    }
+    this.prev = inp.down;
+    return inp;
+  }
+}
diff --git a/src/core/fishing/angling.ts b/src/core/fishing/angling.ts
new file mode 100644
index 0000000..6d2ead9
--- /dev/null
+++ b/src/core/fishing/angling.ts
@@ -0,0 +1,498 @@
+/**
+ * One rod in the water (docs/DESIGN_V2.md 8.4): three beats, one signal each —
+ * see the shadow → wait for the real bite → pull against the run.
+ *
+ *   cast    hold to charge 0.3–1.2 s → 4–14 m; a shadow within 1.5 m of the float comes to it
+ *   wait    4–20 s (halved with bait); 0–3 nibbles (a tap on the float), then the real bite: the
+ *           float goes under. Strike within 0.9 s (rare fish 0.6 s); too early or too late only
+ *           loses the fish (no bait is used up)
+ *   fight   the fish runs left / right / out by its temperament; pulling the other way tires it;
+ *           reeling while it runs loads the line — full for 1.5 s and it snaps; reel while it rests
+ *   land    tired out and reeled to the feet: the catch. One in ten fish is a big one; one hook in
+ *           ten brings up junk (an old boot), one in twenty a bottle with a note
+ *
+ * Pure, seeded, fixed step (1/60 s), serialisable. Input per step is what the hands do; the game
+ * reads mouse buttons and movement into it, a robot angler (angler.ts) can drive it just the same.
+ */
+import type { Land } from '../onfoot/land';
+import { TerrainPoint } from '../onfoot/land';
+import { School, Stream, waterAt, type Shadow, type WaterFacts } from './school';
+import { type Temper } from './species';
+import { speciesById } from './school';
+
+export const FISH_STEP = 1 / 60;
+export const CHARGE_MIN = 0.3;
+export const CHARGE_MAX = 1.2;
+export const CAST_MIN = 4;
+export const CAST_MAX = 14;
+export const COME_R = 1.5;
+export const WAIT: readonly [number, number] = [4, 20];
+export const BITE_WINDOW = 0.9;
+export const BITE_WINDOW_RARE = 0.6;
+export const SNAP_FULL = 1.5;
+/** within this of the rod tip the fish is landed */
+export const LAND_R = 1.3;
+/** this much line out and it parts */
+export const LINE_MAX = 30;
+export const JUNK = 'junk.boot';
+export const BOTTLE = 'keep.bottle';
+
+export type Phase = 'idle' | 'charging' | 'flight' | 'waiting' | 'bite' | 'fight' | 'landed';
+export type Run = 'none' | 'left' | 'right' | 'out';
+export type FishEvent = 'cast' | 'plop' | 'nibble' | 'dip' | 'strike' | 'early' | 'miss' | 'run' | 'jump' | 'snap' | 'land' | 'reelin';
+
+export interface FishInput {
+  /** the cast / reel button (left mouse) held */
+  down: boolean;
+  /** pull: + right / − left, + back towards oneself (−1…1 each; mouse movement) */
+  pullX: number;
+  pullY: number;
+  /** give up (right mouse): line in, whatever is on it goes */
+  cancel: boolean;
+}
+
+export interface RodTip {
+  x: number;
+  y: number;
+  z: number;
+  /** facing on the plan (solids' convention) */
+  heading: number;
+}
+
+export interface Catch {
+  id: string;
+  lengthCm: number;
+  big: boolean;
+  /** seconds from the cast to the landing */
+  seconds: number;
+}
+
+interface Hooked {
+  species: string;
+  temper: Temper;
+  size: number;
+  lengthCm: number;
+  big: boolean;
+  rare: boolean;
+  junk: boolean;
+  stamina: number;
+  stamina0: number;
+}
+
+export interface AnglingState {
+  phase: Phase;
+  rng: number;
+  t: number;
+  charge: number;
+  fx: number;
+  fz: number;
+  fy: number;
+  dip: number;
+  wet: boolean;
+  target: number;
+  wait: number;
+  nibbles: number[];
+  window: number;
+  fish: Hooked | null;
+  run: Run;
+  runT: number;
+  tension: number;
+  full: number;
+  castAt: number;
+  clock: number;
+  caught: Catch | null;
+}
+
+export class Angling {
+  phase: Phase = 'idle';
+  readonly rng: Stream;
+  /** time in the phase (s) */
+  t = 0;
+  /** the charge held so far / of the last cast (s) */
+  charge = 0;
+  /** the float on the plan, its height, and how far it is pulled under (0 floating … 1 gone) */
+  fx = 0;
+  fz = 0;
+  fy = 0;
+  dip = 0;
+  /** the float lies in water that can be fished */
+  wet = false;
+  /** the shadow that came (id; 0 = none) */
+  target = 0;
+  /** seconds of waiting left before the real bite, and the nibbles still to come (seconds before the bite) */
+  wait = 0;
+  nibbles: number[] = [];
+  /** seconds left to strike */
+  window = 0;
+  fish: Hooked | null = null;
+  run: Run = 'none';
+  runT = 0;
+  /** line load 0…1, and how long it has been full */
+  tension = 0;
+  full = 0;
+  castAt = 0;
+  clock = 0;
+  /** the last thing landed, until the game takes it */
+  caught: Catch | null = null;
+  /** with bait the wait is halved */
+  bait = false;
+  readonly events: FishEvent[] = [];
+  private wasDown = false;
+  private readonly tp = new TerrainPoint();
+  private readonly wf: WaterFacts = { fishable: false, kind: 'lake', level: 0, depth: 0, body: 0 };
+
+  constructor(
+    seed: number,
+    readonly school: School,
+  ) {
+    this.rng = new Stream(seed ^ 0x51f15e);
+  }
+
+  /** the cast's length for a charge (s) */
+  static castLength(charge: number): number {
+    const c = Math.min(CHARGE_MAX, Math.max(CHARGE_MIN, charge));
+    return CAST_MIN + ((c - CHARGE_MIN) / (CHARGE_MAX - CHARGE_MIN)) * (CAST_MAX - CAST_MIN);
+  }
+
+  /** the charge (s) that throws `d` metres */
+  static chargeFor(d: number): number {
+    const k = Math.min(1, Math.max(0, (d - CAST_MIN) / (CAST_MAX - CAST_MIN)));
+    return CHARGE_MIN + k * (CHARGE_MAX - CHARGE_MIN);
+  }
+
+  /** the line out: from the tip to the float on the plan */
+  lineLength(tip: RodTip): number {
+    return Math.hypot(this.fx - tip.x, this.fz - tip.z);
+  }
+
+  private emit(e: FishEvent): void {
+    this.events.push(e);
+    if (this.events.length > 32) this.events.shift();
+  }
+
+  private shadow(): Shadow | null {
+    if (!this.target) return null;
+    return this.school.shadows.find((s) => s.id === this.target) ?? null;
+  }
+
+  /** let go of whatever is on the line, and wind in */
+  private reset(scare = true): void {
+    const s = this.shadow();
+    if (s) {
+      if (scare) {
+        s.state = 'flee';
+        s.t = 3;
+      } else s.state = 'roam';
+    }
+    this.target = 0;
+    this.fish = null;
+    this.run = 'none';
+    this.tension = 0;
+    this.full = 0;
+    this.dip = 0;
+    this.phase = 'idle';
+    this.t = 0;
+  }
+
+  step(inp: FishInput, tip: RodTip, land: Land): void {
+    const h = FISH_STEP;
+    const pressed = inp.down && !this.wasDown;
+    const released = !inp.down && this.wasDown;
+    this.wasDown = inp.down;
+    this.clock += h;
+    this.t += h;
+    if (inp.cancel && this.phase !== 'idle' && this.phase !== 'landed') {
+      this.emit('reelin');
+      this.reset();
+      return;
+    }
+    switch (this.phase) {
+      case 'idle':
+        if (pressed) {
+          this.phase = 'charging';
+          this.t = 0;
+        }
+        break;
+      case 'charging':
+        this.charge = this.t;
+        if (released) {
+          const d = Angling.castLength(this.t);
+          this.charge = Math.min(CHARGE_MAX, Math.max(CHARGE_MIN, this.t));
+          this.fx = tip.x + Math.cos(tip.heading) * d;
+          this.fz = tip.z + Math.sin(tip.heading) * d;
+          this.phase = 'flight';
+          this.t = 0;
+          this.castAt = this.clock;
+          this.emit('cast');
+        }
+        break;
+      case 'flight':
+        if (this.t >= 0.6) {
+          const w = waterAt(land, this.fx, this.fz, this.tp, this.wf);
+          this.wet = w.fishable;
+          this.fy = Number.isFinite(w.level) && w.depth > 0 ? w.level : this.tp.h;
+          this.phase = 'waiting';
+          this.t = 0;
+          this.target = 0;
+          this.emit('plop');
+          // right on top of a shadow: it darts away
+          this.school.scare(this.fx, this.fz, 0.5, 2);
+        }
+        break;
+      case 'waiting':
+        this.waiting(h, pressed);
+        break;
+      case 'bite':
+        this.dip = Math.min(1, this.dip + h * 8);
+        this.window -= h;
+        if (pressed) {
+          this.hook();
+        } else if (this.window <= 0) {
+          this.emit('miss');
+          this.loseFish();
+        }
+        break;
+      case 'fight':
+        this.fight(h, inp, tip);
+        break;
+      case 'landed':
+        if (pressed) this.phase = 'idle';
+        break;
+    }
+  }
+
+  private waiting(h: number, pressed: boolean): void {
+    if (pressed) {
+      // winding in: a fish that was about to take it is gone
+      if (this.target) this.emit('early');
+      this.emit('reelin');
+      this.reset(true);
+      return;
+    }
+    this.dip = Math.max(0, this.dip - h * 4);
+    if (!this.wet) return;
+    let s = this.shadow();
+    if (!s) {
+      const near = this.school.nearest(this.fx, this.fz, COME_R);
+      if (!near) return;
+      near.state = 'come';
+      this.target = near.id;
+      this.wait = this.rng.range(WAIT[0], WAIT[1]) * (this.bait ? 0.5 : 1);
+      const n = this.rng.int(4);
+      this.nibbles = [];
+      for (let i = 0; i < n; i++) this.nibbles.push(this.rng.range(0.8, this.wait - 0.8));
+      this.nibbles.sort((a, b) => b - a);
+      s = near;
+    }
+    // the shadow swims up under the float
+    const dx = this.fx - s.x;
+    const dz = this.fz - s.z;
+    const d = Math.hypot(dx, dz);
+    if (d > 0.36) {
+      const v = 0.6 * h;
+      s.x += (dx / d) * Math.min(v, d - 0.35);
+      s.z += (dz / d) * Math.min(v, d - 0.35);
+      s.heading = Math.atan2(dz, dx);
+      return;
+    }
+    this.wait -= h;
+    if (this.nibbles.length && this.wait <= this.nibbles[0]) {
+      this.nibbles.shift();
+      this.dip = 0.35;
+      this.emit('nibble');
+    }
+    if (this.wait <= 0) {
+      const sp = speciesById(s.species);
+      this.phase = 'bite';
+      this.t = 0;
+      this.window = sp && sp.rarity >= 2 ? BITE_WINDOW_RARE : BITE_WINDOW;
+      this.emit('dip');
+    }
+  }
+
+  private loseFish(): void {
+    const s = this.shadow();
+    if (s) {
+      s.state = 'flee';
+      s.t = 3;
+    }
+    this.target = 0;
+    this.phase = 'waiting';
+    this.t = 0;
+    this.dip = 0;
+  }
+
+  private hook(): void {
+    const s = this.shadow();
+    if (!s) {
+      this.loseFish();
+      return;
+    }
+    const sp = speciesById(s.species)!;
+    const u = this.rng.next();
+    const junk = u < 0.15;
+    const size = junk ? 1 : sp.size;
+    const temper: Temper = junk ? 'steady' : sp.temper;
+    const base = [6, 8, 11, 18][size] * (s.big && !junk ? 1.5 : 1) * (temper === 'brute' ? 1.4 : 1);
+    this.fish = {
+      species: junk ? (u < 0.1 ? JUNK : BOTTLE) : s.species,
+      temper,
+      size,
+      lengthCm: s.lengthCm,
+      big: s.big && !junk,
+      rare: sp.rarity >= 2,
+      junk,
+      stamina: junk ? 1.5 : base,
+      stamina0: junk ? 1.5 : base,
+    };
+    s.state = 'hooked';
+    this.phase = 'fight';
+    this.t = 0;
+    this.run = 'none';
+    this.runT = this.rng.range(0.4, 0.9);
+    this.tension = 0.3;
+    this.full = 0;
+    this.emit('strike');
+  }
+
+  /** run and rest lengths by temperament (s) */
+  private nextRun(f: Hooked): void {
+    const r = this.rng;
+    if (this.run === 'none' && f.stamina > 0) {
+      const T = f.temper;
+      const lateral = T === 'darting' ? 0.85 : T === 'sinker' ? 0.25 : T === 'steady' ? 0.35 : 0.55;
+      this.run = r.next() < lateral ? (r.next() < 0.5 ? 'left' : 'right') : 'out';
+      this.runT = T === 'darting' ? r.range(0.6, 1.1) : T === 'brute' ? r.range(1.6, 2.6) : T === 'sinker' ? r.range(1.4, 2.2) : r.range(0.9, 1.6);
+      this.emit(T === 'floater' && r.next() < 0.5 ? 'jump' : 'run');
+    } else {
+      this.run = 'none';
+      this.runT = f.temper === 'darting' ? r.range(0.8, 1.3) : r.range(1.3, 2.3);
+    }
+  }
+
+  private fight(h: number, inp: FishInput, tip: RodTip): void {
+    const f = this.fish!;
+    this.runT -= h;
+    if (this.runT <= 0) this.nextRun(f);
+    if (f.stamina <= 0) this.run = 'none';
+    const dx = this.fx - tip.x;
+    const dz = this.fz - tip.z;
+    const d = Math.hypot(dx, dz) || 1e-6;
+    const ox = dx / d;
+    const oz = dz / d;
+    // its right as seen from the bank: the line's direction turned right
+    const rx = -oz;
+    const rz = ox;
+    const reel = inp.down;
+    const px = Math.max(-1, Math.min(1, inp.pullX));
+    const py = Math.max(-1, Math.min(1, inp.pullY));
+    if (this.run !== 'none') {
+      // the right counter: the other way to the run
+      const q = this.run === 'left' ? px : this.run === 'right' ? -px : py;
+      const good = Math.max(0, q);
+      const wrong = Math.max(0, -q);
+      f.stamina -= (0.3 + 1.3 * good) * h;
+      const v = (f.temper === 'brute' ? 1.6 : 1.3) * (1 - 0.6 * good) * h;
+      if (this.run === 'out') {
+        this.fx += ox * v;
+        this.fz += oz * v;
+      } else {
+        const s = this.run === 'left' ? -1 : 1;
+        this.fx += rx * s * v;
+        this.fz += rz * s * v;
+      }
+      this.tension = Math.min(1, this.tension + (reel ? 0.9 : -0.5) * h + wrong * 0.35 * h);
+      if (f.temper === 'floater' && reel) this.tension = Math.min(1, this.tension + 0.3 * h);
+    } else {
+      f.stamina -= 0.12 * h;
+      if (reel) {
+        // reel in: the fish comes; the line holds a working load
+        // a fish with fight left in it will not be drawn in to the feet
+        const v = Math.min((f.stamina > 0 ? 1.1 : 1.6) * h, Math.max(0, d - (f.stamina > 0 ? 3 : 0)));
+        this.fx -= ox * v;
+        this.fz -= oz * v;
+        this.tension += (0.35 - this.tension) * Math.min(1, h * 3);
+      } else this.tension = Math.max(0, this.tension - 0.6 * h);
+    }
+    this.full = this.tension >= 0.999 ? this.full + h : 0;
+    const s = this.shadow();
+    if (s) {
+      s.x = this.fx;
+      s.z = this.fz;
+    }
+    this.dip = 0.6 + 0.4 * this.tension;
+    if (this.full >= SNAP_FULL || this.lineLength(tip) > LINE_MAX) {
+      this.emit('snap');
+      this.school.remove(s!);
+      this.reset(false);
+      this.target = 0;
+      return;
+    }
+    if (this.lineLength(tip) <= LAND_R) {
+      this.caught = { id: f.species, lengthCm: f.junk ? 0 : f.lengthCm, big: f.big, seconds: this.clock - this.castAt };
+      if (s) {
+        if (speciesById(s.species)?.onePerLake && !f.junk) this.school.kingsTaken.add(s.body);
+        this.school.remove(s);
+      }
+      this.target = 0;
+      this.fish = null;
+      this.run = 'none';
+      this.tension = 0;
+      this.dip = 0;
+      this.phase = 'landed';
+      this.t = 0;
+      this.emit('land');
+    }
+  }
+
+  /** the game takes the catch (into the hands or the pack) */
+  takeCatch(): Catch | null {
+    const c = this.caught;
+    this.caught = null;
+    if (this.phase === 'landed') this.phase = 'idle';
+    return c;
+  }
+
+  /** how far the rod bends: 0 straight … 1 at its limit */
+  get bend(): number {
+    return this.phase === 'fight' ? 0.25 + 0.75 * this.tension : this.phase === 'bite' ? 0.2 : 0;
+  }
+
+  /** what is on the line, if anything (species id, stamina left 0…1) */
+  get hooked(): { id: string; stamina: number } | null {
+    return this.fish ? { id: this.fish.species, stamina: Math.max(0, this.fish.stamina / this.fish.stamina0) } : null;
+  }
+
+  toJSON(): AnglingState {
+    return {
+      phase: this.phase,
+      rng: this.rng.s,
+      t: this.t,
+      charge: this.charge,
+      fx: this.fx,
+      fz: this.fz,
+      fy: this.fy,
+      dip: this.dip,
+      wet: this.wet,
+      target: this.target,
+      wait: this.wait,
+      nibbles: [...this.nibbles],
+      window: this.window,
+      fish: this.fish ? { ...this.fish } : null,
+      run: this.run,
+      runT: this.runT,
+      tension: this.tension,
+      full: this.full,
+      castAt: this.castAt,
+      clock: this.clock,
+      caught: this.caught ? { ...this.caught } : null,
+    };
+  }
+
+  load(s: AnglingState): this {
+    const { rng, ...rest } = s;
+    Object.assign(this, { ...rest, nibbles: [...s.nibbles], fish: s.fish ? { ...s.fish } : null, caught: s.caught ? { ...s.caught } : null });
+    this.rng.s = rng;
+    return this;
+  }
+}
diff --git a/src/core/fishing/school.ts b/src/core/fishing/school.ts
new file mode 100644
index 0000000..b2a0d69
--- /dev/null
+++ b/src/core/fishing/school.ts
@@ -0,0 +1,246 @@
+/**
+ * Fish shadows (docs/DESIGN_V2.md 8.4, Animal Crossing's shadows): simple agents in the water near
+ * the player. Each is one fish already — its species, length, and whether it is a big one — so what
+ * is seen is what is caught. They gather in a jetty's zone and are sparse elsewhere; they shy away
+ * from splashes and from someone wading near them; one that sees a float within 1.5 m comes to it.
+ *
+ * Pure, seeded, fixed step; the state (shadows and the random stream) is plain data.
+ */
+import type { Land } from '../onfoot/land';
+import { TerrainPoint } from '../onfoot/land';
+import { BIOMES } from '../world/biomes';
+import { SPECIES, speciesFor, weightOf, type FishWeather, type Species, type WaterKind } from './species';
+
+/** a small random stream whose state can be saved */
+export class Stream {
+  constructor(public s: number) {
+    this.s = s | 0;
+  }
+  next(): number {
+    let t = (this.s = (this.s + 0x6d2b79f5) | 0);
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  }
+  range(a: number, b: number): number {
+    return a + (b - a) * this.next();
+  }
+  int(n: number): number {
+    return Math.floor(this.next() * n);
+  }
+}
+
+/** water fishable here: deeper than this (m) */
+export const FISHABLE_DEPTH = 0.4;
+
+export interface WaterFacts {
+  fishable: boolean;
+  kind: WaterKind;
+  level: number;
+  depth: number;
+  /** which lake / river: the road stretch it lies by (one old king per lake) */
+  body: number;
+}
+
+/** what the water is at (x, z) */
+export function waterAt(land: Land, x: number, z: number, tp: TerrainPoint, out: WaterFacts): WaterFacts {
+  land.shape(x, z, tp);
+  out.level = tp.wl;
+  out.depth = Number.isFinite(tp.wl) ? tp.wl - tp.bed : 0;
+  const frozen = tp.frozen > 0.5;
+  const biome = BIOMES[tp.bt < 0.5 ? tp.ba : tp.bb]?.id ?? 'plains';
+  out.kind = frozen ? 'ice' : tp.wkind === 2 ? 'stream' : biome === 'desert' ? 'oasis' : 'lake';
+  out.body = Math.floor(tp.s / 1250) * 4 + tp.wkind;
+  // ice fishing (a hole and an auger) is a later package
+  out.fishable = out.depth > FISHABLE_DEPTH && !frozen;
+  return out;
+}
+
+export type ShadowState = 'roam' | 'flee' | 'come' | 'hooked';
+
+export interface Shadow {
+  id: number;
+  species: string;
+  size: 0 | 1 | 2 | 3;
+  lengthCm: number;
+  big: boolean;
+  x: number;
+  z: number;
+  heading: number;
+  state: ShadowState;
+  /** seconds left in this state / until the next turn */
+  t: number;
+  /** the lake it belongs to */
+  body: number;
+}
+
+export interface SchoolState {
+  rng: number;
+  next: number;
+  spawnT: number;
+  shadows: Shadow[];
+  kingsTaken: number[];
+}
+
+/** the radius round the player where shadows live, and the counts kept there */
+export const SCHOOL_R = 24;
+export const IN_ZONE = 7;
+export const OUT_ZONE = 2;
+
+export interface Zone {
+  x: number;
+  z: number;
+  r: number;
+}
+
+export interface FishEnv {
+  hour: number;
+  weather: FishWeather;
+}
+
+export class School {
+  shadows: Shadow[] = [];
+  readonly rng: Stream;
+  private next = 1;
+  private spawnT = 0;
+  /** lakes whose old king has been caught */
+  readonly kingsTaken = new Set<number>();
+  private readonly tp = new TerrainPoint();
+  private readonly wf: WaterFacts = { fishable: false, kind: 'lake', level: 0, depth: 0, body: 0 };
+  private readonly list: Species[] = [];
+
+  constructor(seed: number) {
+    this.rng = new Stream(seed ^ 0x2f1c4a7);
+  }
+
+  /** step: keep the shadows near (cx, cz) alive, moving, and as many as the place holds */
+  step(h: number, land: Land, cx: number, cz: number, env: FishEnv, zones: readonly Zone[]): void {
+    let inZone: Zone | null = null;
+    for (const z of zones) if ((z.x - cx) ** 2 + (z.z - cz) ** 2 < (z.r + SCHOOL_R) ** 2) inZone = z;
+    // the far ones go
+    this.shadows = this.shadows.filter((s) => s.state === 'hooked' || (s.x - cx) ** 2 + (s.z - cz) ** 2 < (SCHOOL_R + 10) ** 2);
+    const want = inZone ? IN_ZONE : OUT_ZONE;
+    this.spawnT -= h;
+    if (this.shadows.length < want && this.spawnT <= 0) {
+      this.spawnT = 0.8;
+      this.spawn(land, cx, cz, env, inZone);
+    }
+    for (const s of this.shadows) this.move(s, h, land, inZone);
+  }
+
+  private spawn(land: Land, cx: number, cz: number, env: FishEnv, zone: Zone | null): void {
+    const r = this.rng;
+    for (let tries = 0; tries < 6; tries++) {
+      // in a zone: inside it; elsewhere: anywhere round the player
+      const a = r.next() * Math.PI * 2;
+      const d = zone ? Math.sqrt(r.next()) * zone.r : 4 + r.next() * (SCHOOL_R - 4);
+      const x = (zone ? zone.x : cx) + Math.cos(a) * d;
+      const z = (zone ? zone.z : cz) + Math.sin(a) * d;
+      if ((x - cx) ** 2 + (z - cz) ** 2 > SCHOOL_R * SCHOOL_R) continue;
+      const w = waterAt(land, x, z, this.tp, this.wf);
+      if (!w.fishable) continue;
+      const sp = this.roll(w.kind, w.body, env);
+      if (!sp) return;
+      const big = r.next() < 0.1;
+      const [lo, hi] = sp.len;
+      const lengthCm = Math.round(big ? hi - (hi - lo) * 0.2 * r.next() : lo + (hi - lo) * 0.8 * r.next() ** 1.4);
+      this.shadows.push({ id: this.next++, species: sp.id, size: sp.size, lengthCm, big, x, z, heading: r.next() * Math.PI * 2, state: 'roam', t: r.range(1, 4), body: w.body });
+      return;
+    }
+  }
+
+  private roll(kind: WaterKind, body: number, env: FishEnv): Species | null {
+    const l = this.list;
+    l.length = 0;
+    speciesFor(kind, env.hour, env.weather, l);
+    // one old king per lake: not if caught, and not two at once
+    for (let i = l.length - 1; i >= 0; i--) {
+      if (!l[i].onePerLake) continue;
+      if (this.kingsTaken.has(body) || this.shadows.some((s) => s.species === l[i].id)) l.splice(i, 1);
+    }
+    if (l.length === 0) return null;
+    let total = 0;
+    for (const s of l) total += weightOf(s, env.weather);
+    let u = this.rng.next() * total;
+    for (const s of l) {
+      u -= weightOf(s, env.weather);
+      if (u < 0) return s;
+    }
+    return l[l.length - 1];
+  }
+
+  private move(s: Shadow, h: number, land: Land, zone: Zone | null): void {
+    if (s.state === 'hooked' || s.state === 'come') return; // the line moves these
+    s.t -= h;
+    if (s.t <= 0) {
+      if (s.state === 'flee') s.state = 'roam';
+      s.t = this.rng.range(1.5, 4.5);
+      s.heading += this.rng.range(-1.6, 1.6);
+      // keep to the zone
+      if (zone && (s.x - zone.x) ** 2 + (s.z - zone.z) ** 2 > zone.r * zone.r) s.heading = Math.atan2(zone.z - s.z, zone.x - s.x);
+    }
+    const v = s.state === 'flee' ? 2.6 : 0.35 + 0.1 * s.size;
+    const nx = s.x + Math.cos(s.heading) * v * h;
+    const nz = s.z + Math.sin(s.heading) * v * h;
+    const w = waterAt(land, nx, nz, this.tp, this.wf);
+    if (w.fishable && w.depth > 0.6) {
+      s.x = nx;
+      s.z = nz;
+    } else {
+      // the shore: turn back
+      s.heading += Math.PI * (0.6 + 0.4 * this.rng.next());
+    }
+  }
+
+  /** a splash at (x, z): those within r dart away for t seconds */
+  scare(x: number, z: number, r: number, t = 3): void {
+    for (const s of this.shadows) {
+      if (s.state === 'hooked') continue;
+      const dx = s.x - x;
+      const dz = s.z - z;
+      if (dx * dx + dz * dz > r * r) continue;
+      s.state = 'flee';
+      s.t = t;
+      s.heading = Math.atan2(dz, dx) + this.rng.range(-0.4, 0.4);
+    }
+  }
+
+  /** the roaming shadow nearest to (x, z) within r, or null */
+  nearest(x: number, z: number, r: number): Shadow | null {
+    let best: Shadow | null = null;
+    let bd = r * r;
+    for (const s of this.shadows) {
+      if (s.state !== 'roam') continue;
+      const d = (s.x - x) ** 2 + (s.z - z) ** 2;
+      if (d <= bd) {
+        bd = d;
+        best = s;
+      }
+    }
+    return best;
+  }
+
+  remove(s: Shadow): void {
+    const i = this.shadows.indexOf(s);
+    if (i >= 0) this.shadows.splice(i, 1);
+  }
+
+  toJSON(): SchoolState {
+    return { rng: this.rng.s, next: this.next, spawnT: this.spawnT, shadows: this.shadows.map((s) => ({ ...s })), kingsTaken: [...this.kingsTaken] };
+  }
+
+  load(s: SchoolState): this {
+    this.rng.s = s.rng;
+    this.next = s.next;
+    this.spawnT = s.spawnT;
+    this.shadows = s.shadows.map((x) => ({ ...x }));
+    this.kingsTaken.clear();
+    for (const k of s.kingsTaken) this.kingsTaken.add(k);
+    return this;
+  }
+}
+
+/** a species by id */
+export function speciesById(id: string): Species | undefined {
+  return SPECIES.find((s) => s.id === id);
+}
