--- /dev/null
+++ b/src/game/player/cargoUses.ts
@@ -0,0 +1,126 @@
+/**
+ * The vehicle's cargo in the game: its bay (put on / take off), climbing onto the truck's bed, and
+ * the things riding on it — drawn as one inked mesh hung on the vehicle's own root, so they move
+ * with it (nothing at all while the bay is empty and the vehicle has no carrier to show).
+ */
+import * as THREE from 'three';
+import { CargoBay, cargoOf, type CargoState } from '../../core/onfoot/cargo';
+import { bodyToWorld } from '../../core/onfoot/vehicle';
+import type { Actor, Interactable, InteractSource, Vec3 } from '../../core/interact/interact';
+import { item } from '../../core/items/catalog';
+import { surfaceMaterial } from '../render/materials';
+import { ModelBuilder } from '../vehicle/builder';
+import { bakeTinted, vertexCount } from './shapes3d';
+import { bigScale } from './itemsView';
+import { sizeOf } from '../../core/items/shapes';
+import type { Player } from './player';
+
+const STEEL = 0x5d6468;
+
+export class CargoUses implements InteractSource {
+  readonly bay: CargoBay | null;
+  private readonly climb: Interactable | null = null;
+  private readonly mesh: THREE.Mesh | null = null;
+  private readonly carrier: THREE.BufferGeometry | null = null;
+  private drawn = -1;
+  private readonly b = new Float64Array(9);
+  private readonly m = new THREE.Matrix4();
+
+  constructor(readonly player: Player) {
+    const g = player.game;
+    const spec = cargoOf(g.sim.spec);
+    this.bay = spec ? new CargoBay(g.sim, spec) : null;
+    if (!spec || !this.bay) return;
+    if (spec.climb) {
+      const c = spec.climb;
+      const self = this;
+      this.climb = {
+        id: `${g.sim.spec.id}:climb`,
+        hold: 0,
+        radius: 0.35,
+        through: g.sim.spec.id,
+        aim(out: Vec3): void {
+          bodyToWorld(g.sim, self.b, c.aim.x, c.aim.y, c.aim.z, out);
+        },
+        prompt(a: Actor): string | null {
+          // not with a big thing in the arms, not while it rolls, not when already up there
+          if (a.hands.size === 'large' || Math.abs(g.sim.kmh) > 1) return null;
+          return player.walker.y > g.sim.py - g.sim.spec.cgHeight + 0.4 ? null : '爬上去';
+        },
+        act(): boolean {
+          const p = bodyToWorld(g.sim, self.b, c.x, 0, c.z, { x: 0, y: 0, z: 0 });
+          return player.walker.place(p.x, p.z, player.walker.heading, 0.5);
+        },
+      };
+    }
+    if (spec.carrier) {
+      const k = spec.carrier;
+      const mb = new ModelBuilder();
+      // a welded rack: two arms from the frame, a slatted floor, a low rail round it
+      for (const z of [-k.z * 0.7, k.z * 0.7]) mb.span(k.x1, k.x1 + 0.3, k.y - 0.06, k.y - 0.01, z - 0.03, z + 0.03, STEEL);
+      for (let i = 0; i < 5; i++) mb.span(k.x0, k.x1, k.y - 0.04, k.y, -k.z + (i * 2 * k.z) / 4 - 0.02, -k.z + (i * 2 * k.z) / 4 + 0.02, STEEL);
+      mb.span(k.x0, k.x0 + 0.03, k.y, k.y + 0.14, -k.z, k.z, STEEL);
+      mb.span(k.x0, k.x1, k.y, k.y + 0.14, -k.z - 0.03, -k.z, STEEL);
+      mb.span(k.x0, k.x1, k.y, k.y + 0.14, k.z, k.z + 0.03, STEEL);
+      this.carrier = mb.build();
+    }
+    this.mesh = new THREE.Mesh(new THREE.BufferGeometry(), surfaceMaterial({ vertexColors: true, ink: true }));
+    this.mesh.name = 'player.cargo';
+    this.mesh.visible = false;
+    g.view.parts.root.add(this.mesh);
+  }
+
+  interactablesNear(x: number, z: number, r: number, out: Interactable[]): void {
+    if (!this.bay || !this.player.onFoot) return;
+    this.bay.interactablesNear(x, z, r, out);
+    if (this.climb) out.push(this.climb);
+  }
+
+  /** redraw what rides on the vehicle when it has changed */
+  update(): void {
+    const bay = this.bay;
+    if (!bay || !this.mesh || bay.version === this.drawn) return;
+    this.drawn = bay.version;
+    const list: { id: string; i: number }[] = [];
+    bay.store.slots.forEach((s, i) => s && list.push({ id: s.id, i }));
+    const cp = this.carrier?.getAttribute('position').count ?? 0;
+    let verts = cp;
+    for (const t of list) verts += vertexCount(item(t.id).shape);
+    if (verts === 0) {
+      this.mesh.visible = false;
+      return;
+    }
+    const pos = new Float32Array(verts * 3);
+    const nor = new Float32Array(verts * 3);
+    const col = new Float32Array(verts * 3);
+    let at = 0;
+    if (this.carrier) {
+      pos.set(this.carrier.getAttribute('position').array as Float32Array, 0);
+      nor.set(this.carrier.getAttribute('normal').array as Float32Array, 0);
+      col.set(this.carrier.getAttribute('color').array as Float32Array, 0);
+      at = cp;
+    }
+    for (const t of list) {
+      const p = bay.place(t.i);
+      const d = item(t.id);
+      // lies along the vehicle; a tyre flat, a jerrycan upright
+      this.m.makeRotationY(t.i * 0.35).setPosition(p.x, p.y, p.z);
+      void sizeOf;
+      at += bakeTinted(d.shape, d.tint, this.m, pos, nor, col, at, bigScale(t.id));
+    }
+    const geo = this.mesh.geometry;
+    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
+    geo.setAttribute('normal', new THREE.BufferAttribute(nor, 3));
+    geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
+    geo.computeBoundingSphere();
+    this.mesh.visible = true;
+  }
+
+  toJSON(): CargoState | null {
+    return this.bay ? this.bay.toJSON() : null;
+  }
+
+  load(s: CargoState | null): void {
+    if (this.bay && s) this.bay.load(s);
+  }
+}
