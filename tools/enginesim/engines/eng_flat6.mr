// eng_flat6: 2.7 litre air-cooled boxer six, redline 7200.
// Two banks of three opposed at 180 degrees, firing 1-6-2-4-3-5 every 120 degrees; each bank
// collects into its own heat exchanger and the two meet in one muffler. The cooling fan's whine
// is added at run time (it follows the crank, not the exhaust).
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

public node eng_flat6 {
    alias output __out: engine;

    engine engine(
        name: "eng_flat6",
        starter_torque: 80 * units.lb_ft,
        starter_speed: 280 * units.rpm,
        redline: 7200 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.9,
            burning_efficiency_randomness: 0.2
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.008,
        noise: 0.8,
        jitter: 0.4,
        simulation_frequency: 24000
    )

    wires wires()

    label stroke(70.4 * units.mm)
    label bore(90 * units.mm)
    label rod_length(127.8 * units.mm)
    label compression_height(32 * units.mm)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 8 * units.kg,
        mass: 12 * units.kg,
        friction_torque: 6.0 * units.Nm,
        moment_of_inertia: 1.5 * disk_moment_of_inertia(mass: 12 * units.kg, radius: stroke / 2)
            + disk_moment_of_inertia(mass: 8 * units.kg, radius: 14 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 180 * units.deg
    )

    rod_journal rj1(angle: 0 * units.deg)
    rod_journal rj2(angle: 240 * units.deg)
    rod_journal rj3(angle: 120 * units.deg)
    rod_journal rj4(angle: 180 * units.deg)
    rod_journal rj5(angle: 60 * units.deg)
    rod_journal rj6(angle: 300 * units.deg)
    c0
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)
        .add_rod_journal(rj6)

    piston_parameters piston_params(
        mass: 420 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 560 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 560 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 2.0 * units.L,
        plenum_cross_section_area: 20.0 * units.cm2,
        intake_flow_rate: k_carb(550.0),
        runner_flow_rate: k_carb(160.0),
        runner_length: 9.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9975,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(600.0),
        primary_tube_length: 20.0 * units.inch,
        primary_flow_rate: k_carb(400.0),
        velocity_decay: 1.0,
        volume: 5.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 48 * units.inch,
        impulse_response: ir_lib.minimal_muffling_01
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 1.0,
        length: 56 * units.inch,
        impulse_response: ir_lib.minimal_muffling_01
    )

    cylinder_bank b0(bank_params, angle: 90 * units.deg)
    cylinder_bank b1(bank_params, angle: -90 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 6 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.95,
            primary_length: 3 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.05,
            primary_length: 1 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 60 * units.cc,
                intake_runner_volume: 140 * units.cc,
                intake_runner_cross_section_area: 10.0 * units.cm2,
                exhaust_runner_volume: 55 * units.cc,
                exhaust_runner_cross_section_area: 8.5 * units.cm2,
                flow_attenuation: 1.2,
                flip_display: true,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )
    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.97,
            primary_length: 6 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.03,
            primary_length: 3 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj6,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 1.0,
            primary_length: 1 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 60 * units.cc,
                intake_runner_volume: 140 * units.cc,
                intake_runner_cross_section_area: 10.0 * units.cm2,
                exhaust_runner_volume: 55 * units.cc,
                exhaust_runner_cross_section_area: 8.5 * units.cm2,
                flow_attenuation: 1.2,
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1
            )
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 242 * units.deg,
        gamma: 1.1,
        lift: 400 * units.thou,
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 236 * units.deg,
        gamma: 1.1,
        lift: 380 * units.thou,
        steps: 100
    )

    mc_cam_boxer6 camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 108 * units.deg,
        exhaust_lobe_center: 108 * units.deg,
        base_radius: 500 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 20 * units.deg)
        .add_sample(3000 * units.rpm, 28 * units.deg)
        .add_sample(4000 * units.rpm, 32 * units.deg)
        .add_sample(5000 * units.rpm, 34 * units.deg)
        .add_sample(6000 * units.rpm, 35 * units.deg)
        .add_sample(7000 * units.rpm, 35 * units.deg)
        .add_sample(8000 * units.rpm, 35 * units.deg)
        .add_sample(9000 * units.rpm, 35 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 7450 * units.rpm,
        limiter_duration: 0.05)
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire6, 120 * units.deg)
        .connect_wire(wires.wire2, 240 * units.deg)
        .connect_wire(wires.wire4, 360 * units.deg)
        .connect_wire(wires.wire3, 480 * units.deg)
        .connect_wire(wires.wire5, 600 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_flat6())
}
