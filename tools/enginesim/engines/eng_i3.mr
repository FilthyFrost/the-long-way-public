// eng_i3: 0.66 litre kei-car inline three, DOHC twelve-valve, water-cooled, redline 7500.
// A 68 x 60.4 mm triple firing 1-3-2 every 240 degrees: the one-and-a-half order is the thrum. The
// three primaries are of different lengths and the cylinders breathe a little unequally, so every
// third pulse lands a touch off: the off-beat. A light flywheel, a small can on a short system: buzzy.
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
}

public node eng_i3 {
    alias output __out: engine;

    engine engine(
        name: "eng_i3",
        starter_torque: 35 * units.lb_ft,
        starter_speed: 260 * units.rpm,
        redline: 7500 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.85,
            burning_efficiency_randomness: 0.25
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.008,
        noise: 0.6,
        jitter: 0.45,
        simulation_frequency: 24000
    )

    wires wires()

    label stroke(60.4 * units.mm)
    label bore(68 * units.mm)
    label rod_length(106 * units.mm)
    label compression_height(26 * units.mm)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 5 * units.kg,
        mass: 6 * units.kg,
        friction_torque: 3.0 * units.Nm,
        moment_of_inertia: 1.5 * disk_moment_of_inertia(mass: 6 * units.kg, radius: stroke / 2)
            + disk_moment_of_inertia(mass: 5 * units.kg, radius: 11 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 120 * units.deg)
    rod_journal rj2(angle: 240 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)

    piston_parameters piston_params(
        mass: 220 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 330 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 330 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 1.2 * units.L,
        plenum_cross_section_area: 9.0 * units.cm2,
        intake_flow_rate: k_carb(200.0),
        runner_flow_rate: k_carb(85.0),
        runner_length: 24.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9977,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(180.0),
        primary_tube_length: 14.0 * units.inch,
        primary_flow_rate: k_carb(180.0),
        velocity_decay: 1.0,
        volume: 3.5 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 70 * units.inch,
        impulse_response: ir_lib.real_engine_1
    )

    cylinder_bank b0(bank_params, angle: 0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 3 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.86,
            primary_length: 6 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.1,
            primary_length: 10 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 24.4 * units.cc,
                intake_runner_volume: 90 * units.cc,
                intake_runner_cross_section_area: 6.0 * units.cm2,
                exhaust_runner_volume: 40 * units.cc,
                exhaust_runner_cross_section_area: 5.0 * units.cm2,
                flow_attenuation: 1.0,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )

    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 216 * units.deg,
        gamma: 1.1,
        lift: 300 * units.thou,
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 212 * units.deg,
        gamma: 1.1,
        lift: 290 * units.thou,
        steps: 100
    )

    mc_cam_i3 camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 110 * units.deg,
        exhaust_lobe_center: 110 * units.deg,
        base_radius: 450 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 20 * units.deg)
        .add_sample(3000 * units.rpm, 27 * units.deg)
        .add_sample(4000 * units.rpm, 32 * units.deg)
        .add_sample(5000 * units.rpm, 35 * units.deg)
        .add_sample(6000 * units.rpm, 36 * units.deg)
        .add_sample(7000 * units.rpm, 36 * units.deg)
        .add_sample(8000 * units.rpm, 36 * units.deg)
        .add_sample(9000 * units.rpm, 36 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 7800 * units.rpm,
        limiter_duration: 0.05)
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire3, 240 * units.deg)
        .connect_wire(wires.wire2, 480 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_i3())
}
