// eng_i6: 3.0 litre straight six, DOHC 24-valve, water-cooled, redline 6500.
// 84 x 89.6 mm, firing 1-5-3-6-2-4 every 120 degrees on a seven-bearing crank: a six is balanced in
// itself, and with all six primaries of nearly one length into one collector and a long, well muffled
// system the pulses run evenly into a smooth third order; high up they close into a turbine-like hum.
// Long intake runners give it its broad middle (285 Nm at 4000).
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

public node eng_i6 {
    alias output __out: engine;

    engine engine(
        name: "eng_i6",
        starter_torque: 120 * units.lb_ft,
        starter_speed: 210 * units.rpm,
        redline: 6500 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.92,
            burning_efficiency_randomness: 0.12
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.006,
        noise: 0.45,
        jitter: 0.25,
        simulation_frequency: 22000
    )

    wires wires()

    label stroke(89.6 * units.mm)
    label bore(84 * units.mm)
    label rod_length(135 * units.mm)
    label compression_height(31 * units.mm)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 9 * units.kg,
        mass: 18 * units.kg,
        friction_torque: 9.0 * units.Nm,
        moment_of_inertia: 1.5 * disk_moment_of_inertia(mass: 18 * units.kg, radius: stroke / 2)
            + disk_moment_of_inertia(mass: 9 * units.kg, radius: 14 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 120 * units.deg)
    rod_journal rj2(angle: 240 * units.deg)
    rod_journal rj3(angle: 240 * units.deg)
    rod_journal rj4(angle: 120 * units.deg)
    rod_journal rj5(angle: 0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)

    piston_parameters piston_params(
        mass: 330 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 520 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 520 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 3.0 * units.L,
        plenum_cross_section_area: 25.0 * units.cm2,
        intake_flow_rate: k_carb(600.0),
        runner_flow_rate: k_carb(120.0),
        runner_length: 16.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.99825,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(400.0),
        primary_tube_length: 22.0 * units.inch,
        primary_flow_rate: k_carb(250.0),
        velocity_decay: 1.0,
        volume: 8.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 110 * units.inch,
        impulse_response: ir_lib.default_0
    )

    cylinder_bank b0(bank_params, angle: 0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 8 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.98,
            primary_length: 7 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.02,
            primary_length: 6.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.99,
            primary_length: 6.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.01,
            primary_length: 7 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire6,
            sound_attenuation: 1.0,
            primary_length: 8 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 54 * units.cc,
                intake_runner_volume: 150 * units.cc,
                intake_runner_cross_section_area: 10.0 * units.cm2,
                exhaust_runner_volume: 55 * units.cc,
                exhaust_runner_cross_section_area: 8.0 * units.cm2,
                flow_attenuation: 1.3,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )

    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 226 * units.deg,
        gamma: 1.1,
        lift: 360 * units.thou,
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 222 * units.deg,
        gamma: 1.1,
        lift: 350 * units.thou,
        steps: 100
    )

    mc_cam_i6 camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 112 * units.deg,
        exhaust_lobe_center: 112 * units.deg,
        base_radius: 550 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 20 * units.deg)
        .add_sample(3000 * units.rpm, 28 * units.deg)
        .add_sample(4000 * units.rpm, 33 * units.deg)
        .add_sample(5000 * units.rpm, 35 * units.deg)
        .add_sample(6000 * units.rpm, 36 * units.deg)
        .add_sample(7000 * units.rpm, 36 * units.deg)
        .add_sample(8000 * units.rpm, 36 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 6800 * units.rpm,
        limiter_duration: 0.05)
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire5, 120 * units.deg)
        .connect_wire(wires.wire3, 240 * units.deg)
        .connect_wire(wires.wire6, 360 * units.deg)
        .connect_wire(wires.wire2, 480 * units.deg)
        .connect_wire(wires.wire4, 600 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_i6())
}
