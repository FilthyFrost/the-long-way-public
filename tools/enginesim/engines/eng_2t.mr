// eng_2t: 250 cc two-stroke parallel twin (180-degree crank), air-cooled, mixed oil, redline 9500.
// Engine Simulator only knows four-strokes. Pulse for pulse a 180-degree two-stroke twin is the same
// as a four-stroke inline four whose cylinders 1+4 and 2+3 share a pipe: each pipe gets one blowdown
// per revolution. So: a tiny, short-stroke four (4 x 125 cc) with huge overlap and early, abrupt
// exhaust opening, two long thin pipes standing in for the expansion chambers, and a lot of
// cycle-to-cycle scatter; the two-stroke rasp is layered on afterwards (make_banks.py).
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
}

public node eng_2t {
    alias output __out: engine;

    engine engine(
        name: "eng_2t",
        starter_torque: 25 * units.lb_ft,
        starter_speed: 500 * units.rpm,
        redline: 9500 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.8,
            burning_efficiency_randomness: 0.55
        ),
        throttle_gamma: 1.6,
        hf_gain: 0.012,
        noise: 0.9,
        jitter: 0.6,
        simulation_frequency: 44100
    )

    wires wires()

    label stroke(54.5 * units.mm)
    label bore(54 * units.mm)
    label rod_length(105 * units.mm)
    label compression_height(20 * units.mm)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 1.5 * units.kg,
        mass: 3.0 * units.kg,
        friction_torque: 1.2 * units.Nm,
        moment_of_inertia: disk_moment_of_inertia(mass: 1.5 * units.kg, radius: 6 * units.cm)
            + disk_moment_of_inertia(mass: 3.0 * units.kg, radius: 3 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 180 * units.deg)
    rod_journal rj2(angle: 180 * units.deg)
    rod_journal rj3(angle: 0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: 110 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 120 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 120 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 0.8 * units.L,
        plenum_cross_section_area: 8.0 * units.cm2,
        intake_flow_rate: k_carb(300.0),
        runner_flow_rate: k_carb(200.0),
        runner_length: 4.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.990,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(200.0),
        primary_tube_length: 34.0 * units.inch,
        primary_flow_rate: k_carb(300.0),
        velocity_decay: 0.4,
        volume: 2.5 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 38 * units.inch,
        impulse_response: ir_lib.sharp_0
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 1.0,
        length: 40 * units.inch,
        impulse_response: ir_lib.sharp_0
    )

    cylinder_bank b0(bank_params, angle: 0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 1 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            sound_attenuation: 1.0,
            primary_length: 1 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.0,
            primary_length: 1 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            sound_attenuation: 1.0,
            primary_length: 1 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 17 * units.cc,
                intake_runner_volume: 40 * units.cc,
                intake_runner_cross_section_area: 4.5 * units.cm2,
                exhaust_runner_volume: 25 * units.cc,
                exhaust_runner_cross_section_area: 4.5 * units.cm2,
                flow_attenuation: 1.0,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )

    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    // port-like timing: long and abrupt, lots of overlap
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 272 * units.deg,
        gamma: 0.8,
        lift: 300 * units.thou,
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 284 * units.deg,
        gamma: 0.7,
        lift: 320 * units.thou,
        steps: 100
    )

    mc_cam_i4 camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 100 * units.deg,
        exhaust_lobe_center: 98 * units.deg,
        base_radius: 400 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 14 * units.deg)
        .add_sample(1000 * units.rpm, 16 * units.deg)
        .add_sample(2000 * units.rpm, 20 * units.deg)
        .add_sample(3000 * units.rpm, 25 * units.deg)
        .add_sample(4000 * units.rpm, 28 * units.deg)
        .add_sample(5000 * units.rpm, 30 * units.deg)
        .add_sample(6000 * units.rpm, 30 * units.deg)
        .add_sample(7000 * units.rpm, 28 * units.deg)
        .add_sample(8000 * units.rpm, 26 * units.deg)
        .add_sample(9000 * units.rpm, 24 * units.deg)
        .add_sample(10000 * units.rpm, 22 * units.deg)
        .add_sample(11000 * units.rpm, 22 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 9900 * units.rpm,
        limiter_duration: 0.03)
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire3, 180 * units.deg)
        .connect_wire(wires.wire4, 360 * units.deg)
        .connect_wire(wires.wire2, 540 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_2t())
}
