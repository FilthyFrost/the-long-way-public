// eng_vtwin: 1.2 litre 45-degree cruiser V-twin, air-cooled, pushrod OHV, redline 6000.
// 88.9 x 96.8 mm, both rods on one crank pin: the rear cylinder fires 315 degrees after the front,
// the front 405 after the rear, the uneven potato-potato. Heavy flywheels inside the crankcase, long
// strokes; each cylinder has its own pipe of the two staggered shorty duals, lightly muffled. The
// fins' ring at each (uneven) firing and the pushrods' chatter are layered on (bank_build.py).
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
}

public node eng_vtwin {
    alias output __out: engine;

    engine engine(
        name: "eng_vtwin",
        starter_torque: 70 * units.lb_ft,
        starter_speed: 260 * units.rpm,
        redline: 6000 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.85,
            burning_efficiency_randomness: 0.3
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.009,
        noise: 0.7,
        jitter: 0.45,
        simulation_frequency: 30000
    )

    wires wires()

    label stroke(96.8 * units.mm)
    label bore(88.9 * units.mm)
    label rod_length(189 * units.mm)
    label compression_height(32 * units.mm)

    label v_angle(45 * units.deg)
    // the twin flywheels inside the crankcase
    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 12 * units.kg,
        mass: 6 * units.kg,
        friction_torque: 6.0 * units.Nm,
        moment_of_inertia: disk_moment_of_inertia(mass: 12 * units.kg, radius: 10 * units.cm)
            + disk_moment_of_inertia(mass: 6 * units.kg, radius: 4 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg - (v_angle / 2.0)
    )

    rod_journal rj0(angle: 0.0)
    c0.add_rod_journal(rj0)

    piston_parameters piston_params(
        mass: 600 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 700 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 700 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    // one constant-velocity carburettor between the cylinders
    intake intake(
        plenum_volume: 0.9 * units.L,
        plenum_cross_section_area: 9.0 * units.cm2,
        intake_flow_rate: k_carb(220.0),
        runner_flow_rate: k_carb(165.0),
        runner_length: 6.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9967,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(220.0),
        primary_tube_length: 20.0 * units.inch,
        primary_flow_rate: k_carb(240.0),
        velocity_decay: 0.8,
        volume: 3.5 * units.L
    )

    // the front cylinder's pipe sweeps back past the rear one: longer
    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 36 * units.inch,
        impulse_response: ir_lib.minimal_muffling_01
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 1.0,
        length: 30 * units.inch,
        impulse_response: ir_lib.minimal_muffling_01
    )

    cylinder_bank b0(bank_params, angle: -v_angle / 2.0)
    cylinder_bank b1(bank_params, angle: v_angle / 2.0)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 6 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 75 * units.cc,
                intake_runner_volume: 120 * units.cc,
                intake_runner_cross_section_area: 11.0 * units.cm2,
                exhaust_runner_volume: 70 * units.cc,
                exhaust_runner_cross_section_area: 9.0 * units.cm2,
                flow_attenuation: 1.1,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )
    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.94,
            primary_length: 4 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 75 * units.cc,
                intake_runner_volume: 120 * units.cc,
                intake_runner_cross_section_area: 11.0 * units.cm2,
                exhaust_runner_volume: 70 * units.cc,
                exhaust_runner_cross_section_area: 9.0 * units.cm2,
                flow_attenuation: 1.1,
                flip_display: true,
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1
            )
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 220 * units.deg,
        gamma: 1.0,
        lift: 450 * units.thou,
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 220 * units.deg,
        gamma: 1.0,
        lift: 450 * units.thou,
        steps: 100
    )

    mc_cam_vtwin camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 106 * units.deg,
        exhaust_lobe_center: 106 * units.deg,
        rear_firing: 360 * units.deg - v_angle,
        base_radius: 500 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 8 * units.deg)
        .add_sample(1000 * units.rpm, 10 * units.deg)
        .add_sample(2000 * units.rpm, 22 * units.deg)
        .add_sample(3000 * units.rpm, 30 * units.deg)
        .add_sample(4000 * units.rpm, 34 * units.deg)
        .add_sample(5000 * units.rpm, 35 * units.deg)
        .add_sample(6000 * units.rpm, 35 * units.deg)
        .add_sample(7000 * units.rpm, 35 * units.deg)
        .add_sample(8000 * units.rpm, 35 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 6300 * units.rpm,
        limiter_duration: 0.06)
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire2, 360 * units.deg - v_angle)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_vtwin())
}
