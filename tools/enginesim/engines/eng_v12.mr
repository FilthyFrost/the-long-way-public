// eng_v12: 5.5 litre 60-degree V12, DOHC 48-valve, water-cooled, redline 7000.
// 88 x 75.2 mm on an inline-six crank, each pin shared by a pair: each bank is a straight six firing
// every 120 degrees, the two banks interleaved 60 degrees apart, one firing every 60 degrees (order
// 1-11-5-9-3-12-6-8-2-10-4-7). Perfectly balanced and overlapping power strokes: at idle the pulses
// run together into a smooth, soft purr; each bank has its own lightly muffled pipe, the two of one
// length so that each bank's third order (its 120-degree beat, half a period apart from the other's)
// cancels, and equal-length primaries (no cylinder louder or later than another, so no first or
// second order either): high up the sixth order climbs past 700 Hz with its harmonics stacked on it,
// the wail.
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
    output wire9: ignition_wire();
    output wire10: ignition_wire();
    output wire11: ignition_wire();
    output wire12: ignition_wire();
}

public node eng_v12 {
    alias output __out: engine;

    engine engine(
        name: "eng_v12",
        starter_torque: 160 * units.lb_ft,
        starter_speed: 200 * units.rpm,
        redline: 7000 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.93,
            burning_efficiency_randomness: 0.12
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.008,
        noise: 0.5,
        jitter: 0.25,
        simulation_frequency: 24000
    )

    wires wires()

    label stroke(75.2 * units.mm)
    label bore(88 * units.mm)
    label rod_length(140 * units.mm)
    label compression_height(29 * units.mm)

    label v_angle(60 * units.deg)
    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 10 * units.kg,
        mass: 24 * units.kg,
        friction_torque: 16.0 * units.Nm,
        moment_of_inertia: 1.5 * disk_moment_of_inertia(mass: 24 * units.kg, radius: stroke / 2)
            + disk_moment_of_inertia(mass: 10 * units.kg, radius: 15 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg - (v_angle / 2.0)
    )

    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 120 * units.deg)
    rod_journal rj2(angle: 240 * units.deg)
    rod_journal rj3(angle: 240 * units.deg)
    rod_journal rj4(angle: 120 * units.deg)
    rod_journal rj5(angle: 0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)

    piston_parameters piston_params(
        mass: 320 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 500 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 500 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 5.0 * units.L,
        plenum_cross_section_area: 40.0 * units.cm2,
        intake_flow_rate: k_carb(1000.0),
        runner_flow_rate: k_carb(130.0),
        runner_length: 12.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9979,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(700.0),
        primary_tube_length: 36.0 * units.inch,
        primary_flow_rate: k_carb(300.0),
        velocity_decay: 1.0,
        volume: 8.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 90 * units.inch,
        impulse_response: ir_lib.minimal_muffling_03
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 1.0,
        length: 90 * units.inch,
        impulse_response: ir_lib.minimal_muffling_03
    )

    cylinder_bank b0(bank_params, angle: -v_angle / 2.0)
    cylinder_bank b1(bank_params, angle: v_angle / 2.0)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire6,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 45.7 * units.cc,
                intake_runner_volume: 120 * units.cc,
                intake_runner_cross_section_area: 9.0 * units.cm2,
                exhaust_runner_volume: 45 * units.cc,
                exhaust_runner_cross_section_area: 7.0 * units.cm2,
                flow_attenuation: 1.3,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )
    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire7,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire8,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire9,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire10,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire11,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire12,
            sound_attenuation: 1.0,
            primary_length: 7.5 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 45.7 * units.cc,
                intake_runner_volume: 120 * units.cc,
                intake_runner_cross_section_area: 9.0 * units.cm2,
                exhaust_runner_volume: 45 * units.cc,
                exhaust_runner_cross_section_area: 7.0 * units.cm2,
                flow_attenuation: 1.3,
                flip_display: true,
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1
            )
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 244 * units.deg,
        gamma: 1.1,
        lift: 400 * units.thou,
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 240 * units.deg,
        gamma: 1.1,
        lift: 390 * units.thou,
        steps: 100
    )

    mc_cam_v12 camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 110 * units.deg,
        exhaust_lobe_center: 110 * units.deg,
        base_radius: 500 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 10 * units.deg)
        .add_sample(1000 * units.rpm, 14 * units.deg)
        .add_sample(2000 * units.rpm, 26 * units.deg)
        .add_sample(3000 * units.rpm, 28 * units.deg)
        .add_sample(4000 * units.rpm, 33 * units.deg)
        .add_sample(5000 * units.rpm, 35 * units.deg)
        .add_sample(6000 * units.rpm, 36 * units.deg)
        .add_sample(7000 * units.rpm, 36 * units.deg)
        .add_sample(8000 * units.rpm, 36 * units.deg)
        .add_sample(9000 * units.rpm, 36 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 7300 * units.rpm,
        limiter_duration: 0.05)
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire11, 60 * units.deg)
        .connect_wire(wires.wire5, 120 * units.deg)
        .connect_wire(wires.wire9, 180 * units.deg)
        .connect_wire(wires.wire3, 240 * units.deg)
        .connect_wire(wires.wire12, 300 * units.deg)
        .connect_wire(wires.wire6, 360 * units.deg)
        .connect_wire(wires.wire8, 420 * units.deg)
        .connect_wire(wires.wire2, 480 * units.deg)
        .connect_wire(wires.wire10, 540 * units.deg)
        .connect_wire(wires.wire4, 600 * units.deg)
        .connect_wire(wires.wire7, 660 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_v12())
}
