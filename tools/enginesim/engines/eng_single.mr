// eng_single: 250 cc motorcycle single, DOHC four-valve, air-cooled, redline 9000.
// Short and light: a 72 x 61 mm cylinder, a small flywheel, a two-into-one-can street exhaust.
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
}

public node eng_single {
    alias output __out: engine;

    engine engine(
        name: "eng_single",
        starter_torque: 20 * units.lb_ft,
        starter_speed: 500 * units.rpm,
        redline: 9000 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.9,
            burning_efficiency_randomness: 0.25
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.004,
        noise: 0.35,
        jitter: 0.3,
        simulation_frequency: 44100
    )

    wires wires()

    label stroke(61.2 * units.mm)
    label bore(72 * units.mm)
    label rod_length(108 * units.mm)
    label compression_height(22 * units.mm)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 1.8 * units.kg,
        mass: 2.5 * units.kg,
        friction_torque: 1.0 * units.Nm,
        moment_of_inertia: disk_moment_of_inertia(mass: 1.8 * units.kg, radius: 6.5 * units.cm)
            + disk_moment_of_inertia(mass: 2.5 * units.kg, radius: 3 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0.0)
    c0.add_rod_journal(rj0)

    piston_parameters piston_params(
        mass: 180 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 200 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 200 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 0.6 * units.L,
        plenum_cross_section_area: 7.0 * units.cm2,
        intake_flow_rate: k_carb(250.0),
        runner_flow_rate: k_carb(300.0),
        runner_length: 6.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.991,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(350.0),
        primary_tube_length: 28.0 * units.inch,
        primary_flow_rate: k_carb(350.0),
        velocity_decay: 0.6,
        volume: 2.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 30 * units.inch,
        impulse_response: ir_lib.minimal_muffling_01
    )

    cylinder_bank b0(bank_params, angle: 0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: 2 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 25 * units.cc,
                intake_runner_volume: 80 * units.cc,
                intake_runner_cross_section_area: 6.0 * units.cm2,
                exhaust_runner_volume: 40 * units.cc,
                exhaust_runner_cross_section_area: 5.0 * units.cm2,
                flow_attenuation: 1.3,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )

    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 250 * units.deg,
        gamma: 1.1,
        lift: 330 * units.thou,
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 245 * units.deg,
        gamma: 1.1,
        lift: 310 * units.thou,
        steps: 100
    )

    mc_cam_single camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 106 * units.deg,
        exhaust_lobe_center: 108 * units.deg,
        base_radius: 450 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 12 * units.deg)
        .add_sample(1000 * units.rpm, 14 * units.deg)
        .add_sample(2000 * units.rpm, 20 * units.deg)
        .add_sample(3000 * units.rpm, 28 * units.deg)
        .add_sample(4000 * units.rpm, 33 * units.deg)
        .add_sample(5000 * units.rpm, 36 * units.deg)
        .add_sample(6000 * units.rpm, 37 * units.deg)
        .add_sample(7000 * units.rpm, 38 * units.deg)
        .add_sample(8000 * units.rpm, 38 * units.deg)
        .add_sample(9000 * units.rpm, 38 * units.deg)
        .add_sample(10000 * units.rpm, 38 * units.deg)
        .add_sample(11000 * units.rpm, 38 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 9400 * units.rpm,
        limiter_duration: 0.05)
    ignition_module.connect_wire(wires.wire1, 0 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_single())
}
