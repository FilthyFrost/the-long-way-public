// eng_v6: 3.0 litre 60-degree V6, DOHC 24-valve, water-cooled, redline 6200.
// 93 x 72.6 mm, oversquare and short-stroked, firing 1-2-3-4-5-6 every 120 degrees on six split pins,
// alternating banks: each bank fires every 240 degrees, like a triple, and has its own pipe. The two
// pipes are of different lengths and lightly muffled, so the two triples' pulse trains rub against
// each other instead of merging into one smooth six: raspier, harder-edged than the straight six.
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

public node eng_v6 {
    alias output __out: engine;

    engine engine(
        name: "eng_v6",
        starter_torque: 110 * units.lb_ft,
        starter_speed: 210 * units.rpm,
        redline: 6200 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.9,
            burning_efficiency_randomness: 0.22
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.010,
        noise: 0.85,
        jitter: 0.45,
        simulation_frequency: 22000
    )

    wires wires()

    label stroke(72.6 * units.mm)
    label bore(93 * units.mm)
    label rod_length(133 * units.mm)
    label compression_height(30 * units.mm)

    label v_angle(60 * units.deg)
    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 9 * units.kg,
        mass: 15 * units.kg,
        friction_torque: 9.0 * units.Nm,
        moment_of_inertia: 1.5 * disk_moment_of_inertia(mass: 15 * units.kg, radius: stroke / 2)
            + disk_moment_of_inertia(mass: 9 * units.kg, radius: 14 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg - (v_angle / 2.0)
    )

    rod_journal rj1(angle: 0 * units.deg)
    rod_journal rj2(angle: 180 * units.deg)
    rod_journal rj3(angle: 240 * units.deg)
    rod_journal rj4(angle: 60 * units.deg)
    rod_journal rj5(angle: 120 * units.deg)
    rod_journal rj6(angle: 300 * units.deg)
    c0
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)
        .add_rod_journal(rj6)

    piston_parameters piston_params(
        mass: 380 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 560 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 560 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 2.8 * units.L,
        plenum_cross_section_area: 24.0 * units.cm2,
        intake_flow_rate: k_carb(580.0),
        runner_flow_rate: k_carb(125.0),
        runner_length: 13.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.9979,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(420.0),
        primary_tube_length: 18.0 * units.inch,
        primary_flow_rate: k_carb(330.0),
        velocity_decay: 1.0,
        volume: 5.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 66 * units.inch,
        impulse_response: ir_lib.minimal_muffling_02
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 1.0,
        length: 80 * units.inch,
        impulse_response: ir_lib.minimal_muffling_02
    )

    cylinder_bank b0(bank_params, angle: -v_angle / 2.0)
    cylinder_bank b1(bank_params, angle: v_angle / 2.0)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 9 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 0.93,
            primary_length: 5 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.06,
            primary_length: 2 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 54.8 * units.cc,
                intake_runner_volume: 160 * units.cc,
                intake_runner_cross_section_area: 11.0 * units.cm2,
                exhaust_runner_volume: 60 * units.cc,
                exhaust_runner_cross_section_area: 8.5 * units.cm2,
                flow_attenuation: 1.2,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )
    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.97,
            primary_length: 8 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire4,
            sound_attenuation: 1.04,
            primary_length: 4 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.002)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj6,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 0.95,
            primary_length: 1 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 54.8 * units.cc,
                intake_runner_volume: 160 * units.cc,
                intake_runner_cross_section_area: 11.0 * units.cm2,
                exhaust_runner_volume: 60 * units.cc,
                exhaust_runner_cross_section_area: 8.5 * units.cm2,
                flow_attenuation: 1.2,
                flip_display: true,
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1
            )
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 226 * units.deg,
        gamma: 1.1,
        lift: 400 * units.thou,
        steps: 100
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 226 * units.deg,
        gamma: 1.1,
        lift: 380 * units.thou,
        steps: 100
    )

    mc_cam_v6 camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 110 * units.deg,
        exhaust_lobe_center: 110 * units.deg,
        base_radius: 550 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 12 * units.deg)
        .add_sample(1000 * units.rpm, 16 * units.deg)
        .add_sample(2000 * units.rpm, 28 * units.deg)
        .add_sample(3000 * units.rpm, 32 * units.deg)
        .add_sample(4000 * units.rpm, 33 * units.deg)
        .add_sample(5000 * units.rpm, 35 * units.deg)
        .add_sample(6000 * units.rpm, 36 * units.deg)
        .add_sample(7000 * units.rpm, 36 * units.deg)
        .add_sample(8000 * units.rpm, 36 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 6500 * units.rpm,
        limiter_duration: 0.05)
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire2, 120 * units.deg)
        .connect_wire(wires.wire3, 240 * units.deg)
        .connect_wire(wires.wire4, 360 * units.deg)
        .connect_wire(wires.wire5, 480 * units.deg)
        .connect_wire(wires.wire6, 600 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_v6())
}
