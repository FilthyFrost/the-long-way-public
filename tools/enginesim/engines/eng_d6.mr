// eng_d6: 6.0 litre inline-six diesel (motorhome), water-cooled, redline 2800.
// Long stroke, enormous flywheel, firing 1-5-3-6-2-4. As with eng_i4d the compression ignition is
// approximated (hard fast burn, early timing, high compression) and the knock layered on afterwards.
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

private node hard_burn {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 4.0)
            .add_sample(5.0, 2.2 * 5.0)
            .add_sample(10.0, 2.4 * 10.0)
            .add_sample(15.0, 2.5 * 15.0)
            .add_sample(20.0, 2.5 * 20.0)
            .add_sample(25.0, 2.5 * 25.0)
            .add_sample(30.0, 2.5 * 30.0)
            .add_sample(35.0, 2.5 * 35.0)
            .add_sample(40.0, 2.5 * 40.0)
            .add_sample(45.0, 2.5 * 45.0);
}

public node eng_d6 {
    alias output __out: engine;

    engine engine(
        name: "eng_d6",
        starter_torque: 450 * units.lb_ft,
        starter_speed: 160 * units.rpm,
        redline: 2800 * units.rpm,
        fuel: fuel(
            turbulence_to_flame_speed_ratio: hard_burn(),
            max_burning_efficiency: 0.9,
            burning_efficiency_randomness: 0.25
        ),
        throttle_gamma: 1.0,
        hf_gain: 0.01,
        noise: 0.6,
        jitter: 0.45,
        simulation_frequency: 14000
    )

    wires wires()

    label stroke(110 * units.mm)
    label bore(108 * units.mm)
    label rod_length(190 * units.mm)
    label compression_height(55 * units.mm)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 35 * units.kg,
        mass: 50 * units.kg,
        friction_torque: 25.0 * units.Nm,
        moment_of_inertia: 1.5 * disk_moment_of_inertia(mass: 50 * units.kg, radius: stroke / 2)
            + disk_moment_of_inertia(mass: 35 * units.kg, radius: 20 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 120 * units.deg)
    rod_journal rj2(angle: 240 * units.deg)
    rod_journal rj3(angle: 240 * units.deg)
    rod_journal rj4(angle: 120 * units.deg)
    rod_journal rj5(angle: 0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)

    piston_parameters piston_params(
        mass: 1600 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 2200 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 2200 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 6.0 * units.L,
        plenum_cross_section_area: 50.0 * units.cm2,
        intake_flow_rate: k_carb(800.0),
        runner_flow_rate: k_carb(300.0),
        runner_length: 12.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.998,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(900.0),
        primary_tube_length: 20.0 * units.inch,
        primary_flow_rate: k_carb(700.0),
        velocity_decay: 1.0,
        volume: 25.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 160 * units.inch,
        impulse_response: ir_lib.real_engine_2
    )

    cylinder_bank b0(bank_params, angle: 0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 10 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.95,
            primary_length: 7 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.05,
            primary_length: 4 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.97,
            primary_length: 4 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.03,
            primary_length: 7 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire6,
            sound_attenuation: 1.0,
            primary_length: 10 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 59 * units.cc,
                intake_runner_volume: 300 * units.cc,
                intake_runner_cross_section_area: 14.0 * units.cm2,
                exhaust_runner_volume: 120 * units.cc,
                exhaust_runner_cross_section_area: 11.0 * units.cm2,
                flow_attenuation: 1.5,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )

    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe lobe(
        duration_at_50_thou: 214 * units.deg,
        gamma: 1.0,
        lift: 420 * units.thou,
        steps: 100
    )

    mc_cam_i6 camshaft(
        intake_lobe_profile: lobe,
        exhaust_lobe_profile: lobe,
        intake_lobe_center: 116 * units.deg,
        exhaust_lobe_center: 116 * units.deg,
        base_radius: 700 * units.thou
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 16 * units.deg)
        .add_sample(500 * units.rpm, 16 * units.deg)
        .add_sample(1000 * units.rpm, 18 * units.deg)
        .add_sample(1500 * units.rpm, 20 * units.deg)
        .add_sample(2000 * units.rpm, 22 * units.deg)
        .add_sample(2500 * units.rpm, 24 * units.deg)
        .add_sample(3000 * units.rpm, 25 * units.deg)
        .add_sample(3500 * units.rpm, 25 * units.deg)
        .add_sample(4000 * units.rpm, 25 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 2950 * units.rpm,
        limiter_duration: 0.15)
    ignition_module
        .connect_wire(wires.wire1, 0 * units.deg)
        .connect_wire(wires.wire5, 120 * units.deg)
        .connect_wire(wires.wire3, 240 * units.deg)
        .connect_wire(wires.wire6, 360 * units.deg)
        .connect_wire(wires.wire2, 480 * units.deg)
        .connect_wire(wires.wire4, 600 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(eng_d6())
}
