// gen_d1: the workshop's generating set: an air-cooled single-cylinder diesel, 418 cc (86 x 72 mm),
// about 19:1, governed to 3000 rpm for 50 Hz (the governor itself is the game's: the recorder holds
// each speed on the dynamometer). A heavy flywheel carries the recoil starter and the cooling fan,
// the alternator's rotor hangs on the crank too; a can muffler sits right on the exhaust port.
// As with eng_i4d / eng_d6 the compression ignition is approximated (hard fast burn, early timing,
// high compression, an open intake) and the injection knock is layered on afterwards (bank_build.py).
// The "starter" here is the rope pulled hard: it gets the engine over its compressions at about
// 500 rpm (the expansion strokes throw it on past the rope's own speed).
import "engine_sim.mr"
import "modcar_lib.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
}

private node hard_burn {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 4.0)
            .add_sample(5.0, 2.2 * 5.0)
            .add_sample(10.0, 2.4 * 10.0)
            .add_sample(15.0, 2.5 * 15.0)
            .add_sample(20.0, 2.5 * 20.0)
            .add_sample(25.0, 2.5 * 25.0)
            .add_sample(30.0, 2.5 * 30.0)
            .add_sample(35.0, 2.5 * 35.0)
            .add_sample(40.0, 2.5 * 40.0)
            .add_sample(45.0, 2.5 * 45.0);
}

public node gen_d1 {
    alias output __out: engine;

    engine engine(
        name: "gen_d1",
        starter_torque: 80 * units.lb_ft,
        starter_speed: 350 * units.rpm,
        redline: 3600 * units.rpm,
        fuel: fuel(
            turbulence_to_flame_speed_ratio: hard_burn(),
            max_burning_efficiency: 0.9,
            burning_efficiency_randomness: 0.3
        ),
        throttle_gamma: 2.0,
        hf_gain: 0.01,
        noise: 0.5,
        jitter: 0.45,
        simulation_frequency: 40000
    )

    wires wires()

    label stroke(72 * units.mm)
    label bore(86 * units.mm)
    label rod_length(118 * units.mm)
    label compression_height(34 * units.mm)

    // flywheel with the fan and the starter cup, plus the alternator's rotor on the same shaft
    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 8 * units.kg,
        mass: 4 * units.kg,
        friction_torque: 5.0 * units.Nm,
        moment_of_inertia: disk_moment_of_inertia(mass: 8 * units.kg, radius: 12 * units.cm)
            + disk_moment_of_inertia(mass: 5 * units.kg, radius: 5 * units.cm)
            + disk_moment_of_inertia(mass: 4 * units.kg, radius: 3.6 * units.cm),
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    rod_journal rj0(angle: 0.0)
    c0.add_rod_journal(rj0)

    piston_parameters piston_params(
        mass: 380 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 420 * units.g,
        moment_of_inertia: rod_moment_of_inertia(mass: 420 * units.g, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    // no throttle plate on a diesel: the "throttle" is the governor's fuel rack (load)
    intake intake(
        plenum_volume: 0.5 * units.L,
        plenum_cross_section_area: 6.0 * units.cm2,
        intake_flow_rate: k_carb(60.0),
        runner_flow_rate: k_carb(70.0),
        runner_length: 4.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.996,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(170.0),
        primary_tube_length: 3.0 * units.inch,
        primary_flow_rate: k_carb(220.0),
        velocity_decay: 0.6,
        volume: 1.6 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        length: 8 * units.inch,
        impulse_response: ir_lib.mild_exhaust_0
    )

    cylinder_bank b0(bank_params, angle: 0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.004)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            primary_length: 1 * units.inch
        )
        .set_cylinder_head(
            mc_head(
                chamber_volume: 23 * units.cc,
                intake_runner_volume: 45 * units.cc,
                intake_runner_cross_section_area: 4.5 * units.cm2,
                exhaust_runner_volume: 30 * units.cc,
                exhaust_runner_cross_section_area: 4.0 * units.cm2,
                flow_attenuation: 0.9,
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0
            )
        )

    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe lobe(
        duration_at_50_thou: 222 * units.deg,
        gamma: 1.0,
        lift: 290 * units.thou,
        steps: 100
    )

    mc_cam_single camshaft(
        intake_lobe_profile: lobe,
        exhaust_lobe_profile: lobe,
        intake_lobe_center: 112 * units.deg,
        exhaust_lobe_center: 112 * units.deg,
        base_radius: 450 * units.thou
    )

    // injection timing: early, as the other diesels (samples closer than the 1000 rpm filter radius)
    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 16 * units.deg)
        .add_sample(500 * units.rpm, 16 * units.deg)
        .add_sample(1000 * units.rpm, 18 * units.deg)
        .add_sample(1500 * units.rpm, 20 * units.deg)
        .add_sample(2000 * units.rpm, 22 * units.deg)
        .add_sample(2500 * units.rpm, 24 * units.deg)
        .add_sample(3000 * units.rpm, 26 * units.deg)
        .add_sample(3500 * units.rpm, 27 * units.deg)
        .add_sample(4000 * units.rpm, 27 * units.deg)
        .add_sample(4500 * units.rpm, 27 * units.deg)

    // the overspeed trip (never reached in the recordings: there is no rev-limiter take)
    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 3700 * units.rpm,
        limiter_duration: 0.1)
    ignition_module.connect_wire(wires.wire1, 0 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(gen_d1())
}
